<% @my_games = Game.by(current_user) %>
<fieldset id="mygames" class="card">
  <legend>
    <%= t("dashboard.my_games.legend", count: @my_games.count) %>
  </legend>

  <%= render "games/list", games: @my_games %>

  <p>
    <%= link_to t("dashboard.my_games.create"), new_game_path, class: "btn" %>
  </p>
</fieldset>
