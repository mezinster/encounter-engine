<% content_for :head do %>
  <script src="/javascripts/jquery.js"></script>
  <script src="/javascripts/jquery.autocomplete.js"></script>
  <link rel="stylesheet" href="/stylesheets/jquery.autocomplete.css">
<% end %>

<script>

    $(document).ready(function() {

        var data = new Array();
        <% @all_users.each do |user| %>
            <% if user != @current_user %>
                data.push({nick: '<%= user.nickname %>', email: '<%= user.email %>'});
            <% end %>
        <% end %>
        $("#invitation_recepient_nickname").autocomplete(data, {
            minChars: 1,
            width: 310,
            matchContains: "word",
            autoFill: false,
            formatItem: function(row, i, max) {
                return i + "/" + max + ": \"" + row.nick + "\" [" + row.email + "]";
            },
            formatMatch: function(row) {
                return row.nick + " " + row.email;
            },
            formatResult: function(row) {
                return row.nick;
            }
        });
    })

</script>

<%= error_messages_for @invitation %>

<%= form_with model: @invitation, url: invitations_path do |f| %>
    <%= f.label :recepient_nickname, t("invitations.new.recipient_label") %>
    <%= f.text_field :recepient_nickname %>
    <%= f.submit t("invitations.new.submit") %>
<% end %>
