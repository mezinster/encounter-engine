<h2>
  <%= t("answers.index.title") %> "<strong><%= @level.name %></strong>"
</h2>

<p>
  <em>(<%= t("answers.index.game_prefix") %> "<%= link_to @game.name, game_path(@game) %>")</em>
</p>

<%= error_messages_for @answer, header: "<h2>#{t("shared.error_header")}</h2>" %>
<br />

<p>
  <em><%= t("answers.index.variants_label") %></em>
</p>
<table>
  <% @answers.each do |answer| %>
  <tr id="answer-<%=  answer.id%>">
    <td><%= answer.value %></td>
    <td><%= link_to t("shared.delete_short"), delete_game_level_question_answer_path(@game, @level, @question, answer) %></td>
  </tr>
<% end %>
</table>

<br />

<%= form_with model: @answer, url: game_level_question_answers_path(@game, @level, @question) do |f| %>
  <p>
    <%= f.label :value, t("answers.index.new_variant_label") %>
    <%= f.text_field :value %>
  </p>
  <%= f.submit t("answers.index.submit") %>
  <em><%= link_to t("shared.cancel"), game_level_path(@game, @level) %></em>
<% end %>
