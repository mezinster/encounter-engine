<div class="page">
  <h2><%= t("games.withdrawal.form.title", :game => @game.name) %></h2>

  <%= form_with url: withdraw_game_path(@game), method: :post do %>
    <div class="field">
      <%= label_tag :withdrawal_category, t("games.withdrawal.form.category") %>
      <%= select_tag :withdrawal_category,
                     options_for_select(Game::WITHDRAWAL_CATEGORIES.map { |c|
                       [ t("games.withdrawal.categories.#{c}"), c ] }) %>
    </div>

    <div class="field">
      <%= label_tag :withdrawal_note, t("games.withdrawal.form.note") %>
      <%= text_area_tag :withdrawal_note, params[:withdrawal_note] %>
    </div>

    <div class="field">
      <%= label_tag :withdrawal_mode, t("games.withdrawal.form.mode") %>
      <%= select_tag :withdrawal_mode,
                     options_for_select([ [ t("games.withdrawal.form.mode_freeze"), "freeze" ],
                                          [ t("games.withdrawal.form.mode_ended"),  "ended" ] ]) %>
    </div>

    <%= submit_tag t("games.withdrawal.form.submit"), :class => "btn danger-row" %>
  <% end %>
</div>
