<%# app/views/teams/index.html.erb %>
<h1><%= t("teams.index.title") %></h1>

<div class="table-wrap">
<table class="table--cards">
  <thead>
    <tr>
      <th><%= t("teams.index.name") %></th>
      <th><%= t("teams.index.captain") %></th>
      <th><%= t("teams.index.members") %></th>
      <th><%= t("teams.index.games_started") %></th>
      <th><%= t("teams.index.games_finished") %></th>
      <th><%= t("teams.index.points_earned") %></th>
      <th><%= t("teams.index.points_deducted") %></th>
      <th><%= t("teams.index.balance") %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  <% @teams.each do |team| %>
    <tr>
      <td data-label="<%= t("teams.index.name") %>"><%= link_to team.name, team_path(team) %></td>
      <%# A captainless team is a valid state (a solo captain may leave), so
          the nil case is a label rather than a dereference. %>
      <td data-label="<%= t("teams.index.captain") %>">
        <%= team.captain&.nickname || t("teams.index.no_captain") %>
      </td>
      <td data-label="<%= t("teams.index.members") %>"><%= team.members.size %></td>
      <td data-label="<%= t("teams.index.games_started") %>"><%= @started.fetch(team.id, 0) %></td>
      <td data-label="<%= t("teams.index.games_finished") %>"><%= @finished.fetch(team.id, 0) %></td>
      <td data-label="<%= t("teams.index.points_earned") %>"><%= @earned.fetch(team.id, 0) %></td>
      <td data-label="<%= t("teams.index.points_deducted") %>"><%= @deducted.fetch(team.id, 0).abs %></td>
      <td data-label="<%= t("teams.index.balance") %>"><%= balance_of(team) %></td>
      <%# Hidden exactly where TeamJoinRequestsController#create refuses, so
          it is never a promise that cannot be kept: the viewer's own team, a
          viewer who captains a team (they must hand over or leave first),
          and a team they have already applied to.

          A form, not a link: no Turbo and no rails-ujs here, so link_to with
          method: :post would silently issue a GET. %>
      <td>
        <%# logged_in? first, and it is not belt-and-braces: the page is public
            now, so @current_user is nil for a guest and the three checks below
            would raise. A guest has nothing to apply with either --
            TeamJoinRequestsController#create requires a session. %>
        <% if logged_in? && !(@current_user.captain? ||
                              @current_user.team == team ||
                              @pending_team_ids.include?(team.id)) %>
          <%= form_with url: team_join_requests_path(:team_id => team.id), method: :post do %>
            <%= submit_tag t("teams.index.apply"), :class => "btn" %>
          <% end %>
        <% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
