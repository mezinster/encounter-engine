<h2>
  <%= t("users.index.title") %> <%= @current_user.nickname %>
  <% if @current_user.captain? %>
    (<%= t("users.index.captain_prefix") %> <%= link_to @current_user.team.name, team_room_path %>)
  <% end %>
</h2>

<div class="table-wrap">
<table>
  <tr><th><%= t("users.index.email_label") %></th>
      <td><%= current_user.email %></td></tr>
  <tr><th><%= t("users.index.date_of_birth_label") %></th>
      <td><%= current_user.date_of_birth %></td></tr>
  <tr><th><%= t("users.index.icq_label") %></th>
      <td><%= current_user.icq_number %></td></tr>
  <tr><th><%= t("users.index.jabber_label") %></th>
      <td><%= current_user.jabber_id %></td></tr>
  <% if current_user.captain? %>
    <tr><th><%= t("users.index.phone_label") %></th>
        <td><%= current_user.phone_number %></td></tr>
  <% end %>
</table>
</div>

<p><em><%= link_to t("users.index.edit_link"), edit_user_path(current_user) %></em></p>
