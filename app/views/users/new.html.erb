<%= error_messages_for @user, header: "<h2>#{t("shared.error_header")}</h2>" %>

<%# data-submit-once: a double-pressed "Register" created the account on the
    first request and answered the second with "this nickname is taken" --
    an error for a signup that had just succeeded. See
    public/javascripts/submit_once.js, and note it is the softer half of the
    fix: the unique indexes added in 20260820130000 are what actually stop
    two accounts existing, since this file is invisible to both suites and
    absent for anyone who blocks scripts. %>
<%= form_with model: @user, url: users_path, html: { "data-submit-once" => "" } do |f| %>
  <div class="field">
    <%= f.label :nickname, t("users.new.nickname_label") %>
    <%= f.text_field :nickname %>
  </div>
  <div class="field">
    <%= f.label :email, t("users.new.email_label") %>
    <%# email_field, not text_field, and that single word is the whole
        production bug of 2026-08-20: iOS capitalises the first letter of a
        plain text input, so addresses went into the database as
        "Ivan@mail.ru" and the lowercase one the player typed at login
        matched nothing. This was the app's LAST text_field :email --
        sessions/new and password_resets/new were already email fields, which
        is exactly why the failure was one-directional and looked so odd.

        type="email" is what suppresses the auto-capitalisation (and gives
        the @-bearing keyboard); autocapitalize and autocorrect cover the
        browsers that take the type as a hint about validation only.
        User#normalise_email is the server-side half, for everything that
        never renders this form at all. %>
    <%= f.email_field :email, :autocapitalize => "none",
                              :autocorrect => "off", :spellcheck => "false" %>
  </div>
  <%# Honeypot. Hidden from people, offered to robots: a scripted client fills
      every input it parses, a human never sees this one. Deliberately NOT
      type="hidden" -- plenty of bots skip those, and the point is that it
      looks like an ordinary field to anything reading the markup.

      The name is bait ("website" is a field spam tooling expects on a signup
      form), so it must not be renamed to anything self-describing.

      Three attributes are for people, not robots:
        aria-hidden  keeps it out of the screen-reader tree -- without it this
                     traps blind users and nobody else
        tabindex=-1  keeps it out of the keyboard order
        autocomplete keeps password managers from filling it helpfully

      Hidden by class, not an inline style, so the rule lives with the rest of
      the CSS -- see .hp-field in components.css, which also explains why it is
      positioned off-screen rather than display:none. %>
  <div class="hp-field" aria-hidden="true">
    <%= label_tag :website, "Website" %>
    <%= text_field_tag :website, nil, :tabindex => -1, :autocomplete => "off" %>
  </div>

  <%= f.submit t("users.new.submit"), class: "btn btn--go",
               "data-submitting-label" => t("users.new.submitting") %>
<% end %>
