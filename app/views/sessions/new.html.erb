<% page_title t("titles.login") %>
<h2><%= t("sessions.new.title") %></h2>

<%# No flash[:error] block here: the layout's flash loop already renders
    flash.now[:error] with role="alert", and rendering it here too showed the
    message twice. %>

<%= form_with url: login_path, method: :post do %>
  <div class="field">
    <%= label_tag :email, t("sessions.new.email_label") %>
    <%= email_field_tag :email %>
  </div>
  <div class="field">
    <%= label_tag :password, t("sessions.new.password_label") %>
    <%= password_field_tag :password %>
  </div>
  <%= submit_tag t("sessions.new.submit"), class: "btn btn--go" %>
<% end %>

<%= link_to t("password_resets.new.link"), new_password_reset_path %>
