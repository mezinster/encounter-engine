<h2>
  <%= t("levels.edit.title") %> "<strong><%= @level.name %></strong>"
</h2>

<p>
  <em>(<%= t("levels.edit.game_prefix") %> "<%= link_to @level.game.name, game_path(@level.game) %>")</em>
</p>

<%= error_messages_for @level, header: "<h2>#{t("shared.error_header")}</h2>" %>

<% active_locale = params[:tab].presence_in(@level.game.available_locale_list) || @level.game.primary_locale %>
<%= render "shared/language_tabs", :game => @level.game, :record => @level,
                                   :fields => Level::TRANSLATABLE_FIELDS,
                                   :active => active_locale %>

<%= form_with model: [@level.game, @level], url: game_level_path(@level.game, @level) do |f| %>
  <div class="field">
    <%= f.label :name, t("levels.form.name") %>
    <% if active_locale == @level.game.primary_locale %>
      <%= f.text_field :name %>
    <% else %>
      <%= text_field_tag "level[translations][#{active_locale}][name]",
                         @level.translation_draft(:name, active_locale) %>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :text, t("levels.form.text") %>
    <% if active_locale == @level.game.primary_locale %>
      <%= f.text_area :text %>
    <% else %>
      <%= text_area_tag "level[translations][#{active_locale}][text]",
                        @level.translation_draft(:text, active_locale) %>
    <% end %>
  </div>
  <%= f.submit t("levels.edit.submit"), class: "btn btn--go" %>
  <em><%= link_to t("shared.cancel"), game_level_path(@level.game, @level) %></em>
<% end %>
