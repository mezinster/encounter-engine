<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t("layout.title") %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <link rel="stylesheet" href="<%= versioned_asset("/stylesheets/tokens.css") %>">
    <link rel="stylesheet" href="<%= versioned_asset("/stylesheets/base.css") %>">
    <link rel="stylesheet" href="<%= versioned_asset("/stylesheets/layout.css") %>">
    <link rel="stylesheet" href="<%= versioned_asset("/stylesheets/components.css") %>">
    <link rel="stylesheet" href="<%= versioned_asset("/stylesheets/screens.css") %>">
    <script src="<%= versioned_asset("/javascripts/theme.js") %>"></script>
    <%= yield :head %>
  </head>
  <body>
    <div class="page page--focused">
      <header class="topbar"><%= render "layouts/header" %></header>
      <main class="main">
        <% flash.each do |type, message| %>
          <p class="flash flash--<%= type %>" role="<%= type.to_s == "notice" ? "status" : "alert" %>"><%= message %></p>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
