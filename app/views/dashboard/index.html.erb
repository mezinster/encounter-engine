<% page_title t("titles.dashboard") %>
<p class="dash-greeting">
  <%= t("dashboard.index.greeting") %> <%= @current_user.nickname %>
</p>

<div class="dash-grid">
  <%= render "my_team" %>

  <%= render "my_games" %>

  <%= render "shared/current_games" %>

  <%= render "shared/test_runs" %>

  <%= render "dashboard/coming_games" %>

  <%= render "dashboard/finished_games" %>

  <%= render "games/game_entries", game_entries: @game_entries, empty_text: nil %>

  <%= render "dashboard/teams_by_game", teams_by_game: @teams_by_game %>
</div>
