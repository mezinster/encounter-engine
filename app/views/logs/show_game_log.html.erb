<h1><%= t("logs.show_game_log.title", team: @team.name, game: @game.name) %></h1>

<% @game.levels.each do |level| %>
  <h2><%= level.name %></h2>
  <strong><%= t("logs.show_game_log.correct_answer") %></strong>&nbsp;<%= level.questions.first.correct_answer %>
  <ul>
  <% logs = Log.of_game(level) %>
  <% logs.each do |log| %>
    <li><%= log.time.strftime("%H:%M:%S") %>&nbsp;<%= log.answer %></li>
  <% end %>
  </ul>
<%  end %>
