<h1><%= t("admin.dashboard.show.title") %></h1>

<h2><%= t("admin.dashboard.show.games_by_status") %></h2>
<div class="stat-grid">
  <% @games_by_status.each do |status, count| %>
    <div class="stat">
      <div class="stat-value"><%= count %></div>
      <div class="stat-label"><%= t("admin.dashboard.show.status.#{status}") %></div>
    </div>
  <% end %>
  <div class="stat">
    <div class="stat-value"><%= @editing_locked %></div>
    <div class="stat-label"><%= t("admin.dashboard.show.editing_locked") %></div>
  </div>
</div>

<h2><%= t("admin.dashboard.show.totals") %></h2>
<div class="stat-grid">
  <% @counts.each do |key, count| %>
    <div class="stat">
      <div class="stat-value"><%= count %></div>
      <div class="stat-label"><%= t("admin.dashboard.show.total.#{key}") %></div>
    </div>
  <% end %>
</div>

<h2><%= t("admin.dashboard.show.entries_by_status") %></h2>
<div class="stat-grid">
  <% @entries_by_status.each do |status, count| %>
    <div class="stat">
      <%# GameEntry.status is a free string column, so a value nobody
          anticipated must render as itself rather than raise under
          raise_on_missing_translations. %>
      <div class="stat-value"><%= count %></div>
      <div class="stat-label"><%= t("admin.dashboard.show.entry_status.#{status}", :default => status.to_s) %></div>
    </div>
  <% end %>
</div>

<h2><%= t("admin.dashboard.show.storage") %></h2>
<div class="stat-grid">
  <div class="stat">
    <div class="stat-value"><%= @storage_used_megabytes %></div>
    <div class="stat-label"><%= t("admin.dashboard.show.storage_used") %></div>
  </div>
  <div class="stat">
    <div class="stat-value"><%= @storage_cap_megabytes %></div>
    <div class="stat-label"><%= t("admin.dashboard.show.storage_cap") %></div>
  </div>
  <div class="stat">
    <div class="stat-value"><%= @disk_free_megabytes %></div>
    <div class="stat-label"><%= t("admin.dashboard.show.disk_free") %></div>
  </div>
  <div class="stat">
    <div class="stat-value"><%= @disk_floor_megabytes %></div>
    <div class="stat-label"><%= t("admin.dashboard.show.disk_floor") %></div>
  </div>
</div>

<p><%= link_to t("admin.dashboard.show.all_games"), admin_games_path %></p>
<p><%= link_to t("admin.dashboard.show.all_teams"), admin_teams_path %></p>
<p><%= link_to t("admin.dashboard.show.audit_log"), admin_audit_index_path %></p>
<p><%= link_to t("admin.settings.title"), admin_settings_path %></p>
