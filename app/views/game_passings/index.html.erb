<%= t("game_passings.index.title", name: @game.name) %>

<p class="game-control">
  <% if @game.paused? %>
    <%= t("game_passings.index.paused_since", :time => l(@game.paused_at, :format => :long)) %>
    <%= button_to t("game_passings.index.resume"), resume_game_path(@game), :method => :post %>
  <% else %>
    <%= button_to t("game_passings.index.pause"), pause_game_path(@game), :method => :post %>
  <% end %>
</p>

<div class="table-wrap">
<table id="stats" class="table--cards">
  <thead>
    <tr>
      <th><%= t("game_passings.index.team") %></th>
      <th><%= t("game_passings.index.level") %></th>
      <th><%= t("game_passings.index.time_at_level") %></th>
      <th>#</th>
      <th>#</th>
      <th><%= t("game_passings.index.interventions") %></th>
    </tr>
  </thead>
  <tbody>
    <%
      game_passings_sorted_by_current_level_position = @game_passings.sort do |left, right|
        if left.finished?
          -1
        elsif right.finished?
          1
        else
          right.current_level.position <=> left.current_level.position
        end
      end
    %>
    <% game_passings_sorted_by_current_level_position.each do |game_passing| %>
      <tr>
        <td data-label="<%= t("game_passings.index.team") %>"><%= game_passing.team.name %></td>
        <% if game_passing.exited? %>
          <td data-label="<%= t("game_passings.index.level") %>"><%= t("game_passings.index.exited") %></td>
          <td data-label="<%= t("game_passings.index.time_at_level") %>"><%= Level.find(game_passing.current_level_id).name %></td>
        <% elsif game_passing.finished? %>
          <td data-label="<%= t("game_passings.index.level") %>"><%= t("game_passings.index.finished") %></td>
          <td data-label="<%= t("game_passings.index.time_at_level") %>">--:--:--</td>
        <% else %>
          <td data-label="<%= t("game_passings.index.level") %>"><%= game_passing.current_level.name %></td>
          <td data-label="<%= t("game_passings.index.time_at_level") %>"><%= game_passing.time_at_level %></td>
        <% end %>

        <td data-label="#">
          <em>
            <%=
               unless game_passing.finished?
                 link_to t("game_passings.index.level_log"), show_level_log_path(game_id: game_passing.game_id, team_id: game_passing.team_id)
               else
                 t("game_passings.index.level_log")
               end
            %>
          </em>
        </td>

        <td data-label="#">
          <em>
            <%= link_to t("game_passings.index.game_log"), show_game_log_path(game_id: game_passing.game_id, team_id: game_passing.team_id) %>
          </em>
        </td>

        <td data-label="<%= t("game_passings.index.interventions") %>">
          <details>
            <summary class="btn"><%= t("game_passings.index.interventions") %></summary>
            <%= render "intervention_controls", :game_passing => game_passing, :levels => @levels %>
          </details>
        </td>

      </tr>
    <% end %>
  </tbody>
</table>
</div>

<br />

<%= link_to t("game_passings.index.full_log"), show_full_log_path(@game) %>
