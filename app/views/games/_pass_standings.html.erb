<% highlight = defined?(highlight) ? highlight : nil %>
<%# Optional local, same shape as highlight above: a caller that has already
    loaded the standings (GamePassingsController#render_finished_passing, which
    needs them to work out the team's place) passes them in rather than making
    this partial load and sort every completed attempt a second time. The game
    page passes none and computes them here. %>
<% standings ||= game.pass_standings %>
<% if standings.any? %>
  <h3><%= t("games.standings.title") %></h3>
  <div class="table-wrap">
  <table class="table--cards">
    <thead>
      <tr>
        <th><%= t("games.standings.place") %></th>
        <th><%= t("games.standings.team") %></th>
        <th><%= t("games.standings.finished_at") %></th>
        <th><%= t("games.standings.duration") %></th>
      </tr>
    </thead>
    <tbody>
      <% standings.each_with_index do |attempt, index| %>
        <tr class="<%= "is-you" if highlight && attempt == highlight %>">
          <td data-label="<%= t("games.standings.place") %>"><%= index + 1 %></td>
          <td data-label="<%= t("games.standings.team") %>"><%= attempt.team&.name %></td>
          <td data-label="<%= t("games.standings.finished_at") %>"><%= l(attempt.finished_at, :format => :long) %></td>
          <%# distance_of_time_in_words buckets to the nearest few minutes --
              two attempts 25 minutes apart both read "около 3 часов", so a
              table sorted BY duration (Game#pass_standings) looked
              arbitrarily ordered. seconds_to_hms (TimeFormatting, already
              included in GamePassing) is exact and locale-free -- finding 5
              of the whole-branch review. %>
          <td data-label="<%= t("games.standings.duration") %>"><%= attempt.seconds_to_hms(attempt.duration) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
<% end %>
