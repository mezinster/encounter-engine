<h1><%= t("logs.show_level_log.title", team: @team.name, level: @level.name, game: @game.name) %></h1>

<strong><%= t("logs.show_level_log.correct_answer") %></strong>&nbsp;<%= @level.questions.first.correct_answer %>
<ul>
<% @logs.each do |log| %>
  <li><%= log.time.strftime("%H:%M:%S") %>&nbsp;<%= log.answer %></li>
<% end %>
</ul>
