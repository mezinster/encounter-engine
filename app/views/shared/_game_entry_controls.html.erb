<% if game_entry %>
  <% case game_entry.status %>
  <% when "new" %>
    <%= t("shared.game_entry_controls.applied") %>
    <%= button_to t("shared.game_entry_controls.recall"), recall_game_entry_path(game_entry) %>
  <% when "accepted"%> <%= t("shared.game_entry_controls.registered") %>
    <%= button_to t("shared.game_entry_controls.decline"), cancel_game_entry_path(game_entry) %>
  <% when "recalled", "rejected", "canceled", nil %>
    <% if game.can_request? %>
      <%= button_to t("shared.game_entry_controls.reapply"), reopen_game_entry_path(game_entry) %>
    <% else %>
      <%= t("shared.game_entry_controls.entries_exceeded") %>
    <% end %>
  <% end %>
<% else %>
  <% if !game.can_request? %>
    <%= t("shared.game_entry_controls.entries_exceeded") %>
  <% elsif game.registration_deadline and game.registration_deadline <= Time.now %>
    <%= t("shared.game_entry_controls.deadline_passed") %>
  <% else %>
    <%= button_to t("shared.game_entry_controls.apply"), new_game_entry_path(:game_id => game.id, :team_id => team.id) %>
  <% end %>
<% end %>
