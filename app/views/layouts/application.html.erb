<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title_text %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%# theme.js below keeps this in step with the in-app theme toggle. %>
    <meta name="theme-color" content="#12100e">
    <link rel="icon" href="<%= versioned_asset("/favicon.ico") %>" sizes="32x32">
    <link rel="icon" type="image/svg+xml" href="<%= versioned_asset("/icons/favicon.svg") %>">
    <link rel="apple-touch-icon" href="<%= versioned_asset("/apple-touch-icon.png") %>">
    <link rel="manifest" href="<%= versioned_asset("/site.webmanifest") %>">
    <%= csrf_meta_tags %>
    <link rel="stylesheet" href="<%= versioned_asset("/stylesheets/tokens.css") %>">
    <link rel="stylesheet" href="<%= versioned_asset("/stylesheets/base.css") %>">
    <link rel="stylesheet" href="<%= versioned_asset("/stylesheets/layout.css") %>">
    <link rel="stylesheet" href="<%= versioned_asset("/stylesheets/components.css") %>">
    <link rel="stylesheet" href="<%= versioned_asset("/stylesheets/screens.css") %>">
    <script src="<%= versioned_asset("/javascripts/theme.js") %>"></script>
    <%# Individual templates hook additional <script>/<link> tags in here via
        `content_for(:head) { ... }` -- the Rails replacement for Merb's
        require_js/require_css + include_required_js/include_required_css
        (see app/views/games/new.html.erb, games/edit.html.erb,
        invitations/new.html.erb once Task 9b/c ports them). %>
    <%= yield :head %>
  </head>
  <body>
    <%# The checkbox IS the control: focusable, named, and toggled by Space
        natively. The label below is only its visual presentation, so it is
        hidden from assistive tech to avoid announcing the same thing twice. %>
    <input type="checkbox" id="drawer-state"
           aria-label="<%= t("layout.header.menu") %>">

    <div class="page">
      <header class="topbar">
        <label for="drawer-state" id="drawer-toggle" aria-hidden="true">☰</label>
        <%= render "layouts/header" %>
      </header>

      <label for="drawer-state" class="drawer-scrim" aria-hidden="true"></label>

      <nav id="drawer" aria-label="<%= t("layout.header.menu") %>">
        <%= render "layouts/left_menu" %>
      </nav>

      <main class="main">
        <% flash.each do |type, message| %>
          <p class="flash flash--<%= type %>" role="<%= type.to_s == "notice" ? "status" : "alert" %>"><%= message %></p>
        <% end %>
        <%= yield %>
      </main>
    </div>

    <script src="<%= versioned_asset("/javascripts/drawer.js") %>" defer></script>
    <%# Site-wide, but inert unless a form opts in with data-submit-once --
        see the file's own comment for why it is opt-in rather than global. %>
    <script src="<%= versioned_asset("/javascripts/submit_once.js") %>" defer></script>
  </body>
</html>
