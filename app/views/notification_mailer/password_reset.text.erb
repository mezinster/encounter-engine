<%# host: @host, not default_url_options -- config/environments/{test,development}.rb
    set no action_mailer.default_url_options (only production.rb does, see
    NotificationMailer#app_host), so edit_password_reset_url without an
    explicit host raises ActionController::UrlGenerationError outside
    production. @host is already resolved by #app_host for the subject/body
    of every other mail in this class; reusing it here keeps the link
    generation independent of environment config that was never set up for
    URL helpers in the first place. %>
<%= t("notification_mailer.password_reset.body",
      nickname: @user.nickname,
      url: edit_password_reset_url(token: @token, host: @host),
      hours: (User::RESET_PASSWORD_VALID_FOR / 1.hour).to_i) %>
