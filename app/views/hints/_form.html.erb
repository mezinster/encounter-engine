<% active_locale = params[:tab].presence_in(@level.game.available_locale_list) || @level.game.primary_locale %>
<%= render "shared/language_tabs", :game => @level.game, :record => @hint,
                                   :fields => Hint::TRANSLATABLE_FIELDS,
                                   :active => active_locale %>

<div class="field">
  <%= f.label :text, t("hints.form.text_label") %>
  <% if active_locale == @level.game.primary_locale %>
    <%= f.text_field :text %>
  <% else %>
    <%= text_field_tag "hint[translations][#{active_locale}][text]",
                       @hint.translation_draft(:text, active_locale) %>
  <% end %>
</div>

<div class="field">
  <%= f.label :delay_in_minutes, t("hints.form.delay_label") %>
  <%= f.text_field :delay_in_minutes %> <%= t("hints.form.minutes_suffix") %>
</div>

<%= render "game_files/picker", :game => @game, :attachable => @hint,
                                :param_key => "hint", :active_locale => active_locale %>
