#!/bin/bash
# Daily archive of the small, live, irreplaceable set on this host.
#
# Deliberately NOT the whole filesystem: the OS, Docker images and /opt are
# rebuilt by CI or by apt, and the WordPress estate is frozen and archived once
# (see ops/archive-once.sh). What is left is single-digit megabytes -- which is
# what makes the staging and read-back below affordable.
#
# STAGED AND VERIFIED, not streamed. An earlier draft piped tar straight to
# blob. At this size the "don't compete for disk" argument does not apply, and
# streaming has a real cost: a truncated archive uploads and is
# indistinguishable from a good one -- the timer succeeds, the blob exists, the
# size looks plausible. The design's own standard is that a procedure nobody has
# executed is a hypothesis; that is as true of a backup nobody has read back.
#
# ENCRYPTED to public keys only. This archive contains three private keys
# (/var/www/Keys) and the dynamic-DNS credentials in /etc/ddclient.conf, so an
# unencrypted copy in blob storage is an offsite copy of the machine's
# credentials. The host cannot decrypt what it writes -- see Task 2's canary.
set -euo pipefail

RECIPIENTS=/etc/encounter-engine/archive-recipients.txt
CONTAINER=archive-daily

if [ ! -s "$RECIPIENTS" ]; then
  echo "FATAL: no age recipients at $RECIPIENTS; refusing to write a plaintext archive" >&2
  exit 1
fi
# Two recipients is the whole point -- so losing one key does not make every
# backup worthless. A recipients file with only one line satisfies -s above
# and would silently defeat that; counting DISTINCT age1 lines also catches
# the same key listed twice, which would otherwise pass a plain line count.
# `tr -d '\r'` + trailing-whitespace strip before the dedup: a CRLF-edited
# file would otherwise make "age1abc" and "age1abc\r" count as two distinct
# recipients when they are the same key once.
RECIPIENT_COUNT=$(grep '^age1' "$RECIPIENTS" | tr -d '\r' | sed 's/[[:space:]]*$//' | sort -u | wc -l) || true
if [ "$RECIPIENT_COUNT" -lt 2 ]; then
  echo "FATAL: only ${RECIPIENT_COUNT} distinct age1 recipient(s) in $RECIPIENTS; need at least two" >&2
  exit 1
fi

# `docker run -v <name>:/from:ro` auto-creates a named volume that does not
# exist, even read-only -- on a rebuilt host before the first Kamal deploy, or
# if the volume is ever renamed, silently archiving nothing from it. Checked
# before measuring or copying so neither of those steps can be the thing that
# creates it.
if ! docker volume inspect encounter_engine_storage >/dev/null 2>&1; then
  echo "FATAL: docker volume encounter_engine_storage does not exist; refusing to let" >&2
  echo "       'docker run -v ...:ro' silently create an empty one in its place" >&2
  exit 1
fi

# /var/tmp, not /tmp: what is staged below is user-uploaded game files, actively
# growing, and /tmp is the one directory a distribution is entitled to mount as
# a tmpfs or clear underneath a long-running job. (ops/archive-once.sh stages on
# /backup instead -- it moves gigabytes and can afford to be nowhere near /. This
# archive is single-digit megabytes, so /var/tmp is proportionate; the gate below
# is what keeps it honest if that ever stops being true.)
#
# ONE variable for both the `df` target and the `mktemp` template, deliberately:
# a free-space gate that measures a different filesystem from the one being
# written to is worse than no gate, because it reports a number.
STAGE_ROOT=/var/tmp

# Refuse up front, on our own terms, rather than filling the disk mid-tar --
# this box's / also holds the production Postgres data directory (see the Global
# Constraints in the offsite-backup plan).
#
# The uploads volume is the only unbounded term in what gets staged here, so
# measure it rather than trust a static guess: a fixed floor guarding an
# unmeasured, growing payload passes today and fills the disk the day it
# doesn't.
#
# Sized at ~2x SRC_MB, not 3x, because $UPLOADS and $ARCHIVE are each deleted
# below as soon as they are dead (right after the tar, and right after the
# encryption, respectively -- see the comments at those two `rm` lines). What is
# left is THREE moments at which two copies coexist, never more, and 2x covers
# all of them:
#   * during `tar`, $UPLOADS and the $ARCHIVE being written from it;
#   * during `age`, $ARCHIVE and $ARCHIVE.age;
#   * during the read-back compare, $ARCHIVE.age and roundtrip.age.
# Each pair is at most ~2x the uploads volume -- everything else in the tar
# (/etc/ssh, letsencrypt, the units) is a fixed couple of megabytes, and both
# $ARCHIVE and its .age are compressed, so 2x the uncompressed `du` figure is
# an upper bound rather than an estimate. The fsarchiver-style math (source
# size x3) never applied here; there is no equivalent large single file.
#
# The two sides of the comparison need opposite treatment on failure. FREE_MB is
# "how much room exists" -- coercing an unreadable `df` to 0 fails CLOSED,
# since 0 free is always less than any positive requirement. SRC_MB is "how
# big is the payload we're about to stage" -- coercing an unreadable `du` to 0
# would fail OPEN, collapsing REQUIRED_MB to just the margin and staging a
# payload nobody actually measured. So SRC_MB gets its own FATAL on failure
# instead of a 0-coercion.
#
# SRC_MB is checked on the EXIT STATUS too, not only on whether its output
# parses. `du` prints a total AND exits non-zero when a subdirectory is
# unreadable, so a swallowed status yields a real number that is silently too
# small -- a guard that fails open while looking like it measured something.
# Running as root makes that unlikely, not impossible. stderr is deliberately
# not redirected: on a clean run `du` says nothing, so the only thing this can
# print is the name of the path that could not be read.
if ! SRC_DU=$(docker run --rm -v encounter_engine_storage:/from:ro alpine:3 du -sm /from); then
  echo "FATAL: could not measure the encounter_engine_storage volume (see the error above)." >&2
  echo "       A partial du total would under-count the payload -- refusing to size the gate on it" >&2
  exit 1
fi
SRC_MB=$(printf '%s\n' "$SRC_DU" | tail -1 | cut -f1)
case "$SRC_MB" in
  ''|*[!0-9]*)
    echo "FATAL: could not measure the encounter_engine_storage volume; refusing to stage an unmeasured payload" >&2
    exit 1
    ;;
esac
MARGIN_MB=2048
REQUIRED_MB=$(( SRC_MB * 2 + MARGIN_MB ))
FREE_MB=$(df --output=avail -m "$STAGE_ROOT" 2>/dev/null | tail -1 | tr -d ' ') || true
case "$FREE_MB" in ''|*[!0-9]*) FREE_MB=0 ;; esac
if [ "$FREE_MB" -lt "$REQUIRED_MB" ]; then
  echo "FATAL: only ${FREE_MB} MiB free on ${STAGE_ROOT}; need at least ${REQUIRED_MB} MiB (uploads volume ~${SRC_MB} MiB x2 + ${MARGIN_MB} MiB margin)" >&2
  exit 1
fi

STAGE=$(mktemp -d "${STAGE_ROOT}/ee-archive.XXXXXX")
trap 'rm -rf "$STAGE"' EXIT

DATE=$(date -u +%Y-%m-%d)
ARCHIVE="$STAGE/host-state.tar.zst"

# AZURE_STORAGE_ACCOUNT lives on the encounter-engine-db container's
# environment (set from config/deploy.yml), not on the encounter-engine-backup
# systemd unit -- that unit carries no Environment= line at all, it works by
# `docker exec`-ing into the container, which already has these values.
# Follow ops/db-restore-scratch.sh's pattern: read them off the running
# container rather than repeating them here.
DB_CONTAINER=encounter-engine-db
env_of() { docker inspect "$DB_CONTAINER" --format '{{range .Config.Env}}{{println .}}{{end}}' | grep "^$1=" | head -1 | cut -d= -f2-; }
# The `|| true` matters: under pipefail, env_of's internal grep exits 1 when
# nothing matches, which would otherwise fail this assignment and terminate
# the script here -- before the FATAL message below ever runs.
ACCT=$(env_of AZURE_STORAGE_ACCOUNT) || true
if [ -z "$ACCT" ]; then
  echo "FATAL: could not read AZURE_STORAGE_ACCOUNT off the ${DB_CONTAINER} container" >&2
  exit 1
fi

# azcopy reports what a transfer actually did on STDOUT -- per-transfer errors
# and a closing "Final Job Status:" line. Sending that to /dev/null leaves an
# unattended failure with nothing in the journal but a non-zero exit status, on
# a host with no monitoring, where the journal is the entire investigation.
# So: capture it, stay silent when it worked, print all of it to stderr when it
# did not. The status line is checked as well as the exit status because a job
# can end CompletedWithErrors -- some transfers failed, and this archive is only
# worth anything if ALL of it landed.
azcopy_quiet() {
  local out status=0
  # </dev/null is load-bearing, not hygiene. azcopy CONSUMES STDIN, and these
  # scripts are documented as runnable via `ssh host 'bash -s' < script` -- so
  # the first azcopy call eats the remainder of the script, bash reaches
  # end-of-input, and the run exits 0 having done part of the work. That is
  # exactly what happened on the first real run of archive-once.sh: it archived
  # 1 of 4 items and reported success. Detaching stdin makes the script correct
  # under any invocation rather than only when copied to the host first.
  out=$(azcopy "$@" </dev/null 2>&1) || status=$?
  if [ "$status" -ne 0 ] || printf '%s\n' "$out" | grep -qE 'Final Job Status: (Failed|CompletedWithErrors)'; then
    echo "FATAL: azcopy $1 reported failure (exit ${status}); its full output follows" >&2
    printf '%s\n' "$out" >&2
    return 1
  fi
  return 0
}

# Log in HERE, before anything is staged, not just before the upload. A broken
# or unassigned managed identity is a precondition failure, and discovering it
# after the tar means the whole archive was built for nothing -- including
# writing the plaintext tar of three private keys and the ddclient credentials
# to disk. ops/archive-once.sh logs in at the same point, for the same reason.
#
# This is a probe, not the mechanism: encounter-engine-archive.service sets
# AZCOPY_AUTO_LOGIN_TYPE=MSI so each azcopy call authenticates itself, because
# the token cache this login writes lives under $HOME -- which systemd does not
# set for a unit with no User=. See the comments in that unit file.
azcopy_quiet login --identity

# The uploads volume is read out of Docker rather than from /var/lib/docker
# directly: the volume's on-disk path is an implementation detail Docker is
# entitled to change, and reading it live risks catching a half-written file.
# Existence was already checked above, before it could be measured or
# auto-created; what is left to distinguish here is real copy failure from a
# volume that is legitimately empty. Preferring to lose the other 90% of this
# archive -- host keys, /etc/ssh, letsencrypt, ddclient credentials, the units
# themselves -- over reporting a problem with the reconstructible 10% would be
# backwards, so an empty result is a loud WARNING, not a FATAL, unless the
# source demonstrably had something the copy failed to bring over.
UPLOADS="$STAGE/uploads"
mkdir -p "$UPLOADS"
docker run --rm \
  -v encounter_engine_storage:/from:ro \
  -v "$UPLOADS":/to \
  alpine:3 sh -c 'cp -a /from/. /to/'
if [ -z "$(ls -A "$UPLOADS" 2>/dev/null)" ]; then
  SRC_ENTRIES=$(docker run --rm -v encounter_engine_storage:/from:ro alpine:3 sh -c 'ls -A /from | wc -l') || true
  case "$SRC_ENTRIES" in ''|*[!0-9]*) SRC_ENTRIES=0 ;; esac
  if [ "$SRC_ENTRIES" -gt 0 ]; then
    echo "FATAL: encounter_engine_storage has ${SRC_ENTRIES} entries but the copy produced nothing" >&2
    exit 1
  fi
  echo "WARNING: encounter_engine_storage is empty; archiving host state without uploads" >&2
fi

# /etc/ssh whole rather than an enumerated list of host keys: this box has FOUR
# pairs (dsa, ecdsa, ed25519, rsa), and naming three of them would archive three
# quarters of the machine's identity WITHOUT tar complaining -- the omission is
# only visible at restore time, which is the worst time to find it. 560 KB, and
# it brings sshd_config along.
#
# /etc/letsencrypt is included although certificates are reissuable: 1.7 MB, and
# it avoids hitting Let's Encrypt rate limits during a rebuild, which is exactly
# when a rate limit is least welcome.
#
# etc/encounter-engine/archive-recipients.txt (the age recipients file itself)
# is included too: it is the one host-side file the archive system needs to
# keep working after a rebuild, and it is public keys, not a secret -- there
# is no reason to make a rebuilt host depend on someone remembering it.
#
# tar's exit status is handled explicitly, and --warning=no-file-changed is
# deliberately NOT set. GNU tar exits 1 when a file changed while it was being
# read -- a tolerable event here, and a likely one: /etc/letsencrypt is in the
# set above and certbot renews on its own timer. Warnings never affect the exit
# status, so suppressing the message did not suppress the exit 1; under `set -e`
# the run died at this line having printed "building archive" and nothing else,
# and the one line naming the file was the line the flag had suppressed. Exit 1
# is now a loud WARNING (the archive is otherwise complete and worth uploading),
# anything else is FATAL.
echo "building archive"
TAR_STATUS=0
tar --create --zstd --file "$ARCHIVE" \
    --directory / \
    var/www/Keys \
    etc/systemd/system/encounter-engine-backup.service \
    etc/systemd/system/encounter-engine-backup.timer \
    etc/systemd/system/encounter-engine-archive.service \
    etc/systemd/system/encounter-engine-archive.timer \
    etc/systemd/system/ddclient.service \
    usr/local/bin/encounter-engine-backup \
    usr/local/bin/encounter-engine-archive \
    etc/ddclient.conf \
    etc/encounter-engine/archive-recipients.txt \
    etc/ssh \
    etc/letsencrypt \
    etc/crontab etc/cron.d \
    etc/fstab etc/hosts \
    --directory "$STAGE" uploads || TAR_STATUS=$?
if [ "$TAR_STATUS" -eq 1 ]; then
  echo "WARNING: tar exited 1 -- a file changed while being read (tar named it above)." >&2
  echo "         Every other member was archived; continuing with this archive." >&2
elif [ "$TAR_STATUS" -ne 0 ]; then
  echo "FATAL: tar failed with exit ${TAR_STATUS}; the archive is not trustworthy" >&2
  exit 1
fi

PLAIN_SUM=$(sha256sum "$ARCHIVE" | cut -d' ' -f1)
echo "archive: $(stat -c%s "$ARCHIVE") bytes, sha256 $PLAIN_SUM"

# $UPLOADS is fully captured inside $ARCHIVE now (tar has already run); dead
# weight from here on, and the one component here with real room to grow.
rm -rf "$UPLOADS"

echo "encrypting"
age -R "$RECIPIENTS" -o "$ARCHIVE.age" "$ARCHIVE"

# $ARCHIVE is the plaintext tar -- three private keys and the ddclient
# credentials, per the header comment -- and PLAIN_SUM was already captured
# above, so nothing downstream needs it on disk. Deleting it here both keeps
# the free-space math above honest (see "sized at ~2x") and stops the
# plaintext sitting through the upload and read-back that follow.
rm -f "$ARCHIVE"

URL="https://${ACCT}.blob.core.windows.net/${CONTAINER}/${DATE}/host-state.tar.zst.age"
echo "uploading to $URL"
azcopy_quiet copy "$ARCHIVE.age" "$URL" --overwrite=true

# Read it back. Not "does the blob exist" -- does the blob, once downloaded,
# have the same bytes we uploaded. Decryption cannot be checked here by design
# (no private key on this host), so the ciphertext digest is what we compare.
echo "verifying by read-back"
UP_SUM=$(sha256sum "$ARCHIVE.age" | cut -d' ' -f1)
azcopy_quiet copy "$URL" "$STAGE/roundtrip.age"
DOWN_SUM=$(sha256sum "$STAGE/roundtrip.age" | cut -d' ' -f1)

if [ "$UP_SUM" != "$DOWN_SUM" ]; then
  echo "FATAL: read-back mismatch. uploaded $UP_SUM, downloaded $DOWN_SUM" >&2
  exit 1
fi

echo "OK: ${DATE} archive verified, ciphertext sha256 $UP_SUM"
