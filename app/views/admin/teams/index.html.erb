<% page_title t("titles.admin") %>
<%# app/views/admin/teams/index.html.erb %>
<h1><%= t("admin.teams.index.title") %></h1>

<% if @teams.empty? %>
  <%= render "shared/empty_state", :title => t("empty_states.admin_teams"), :variant => :line %>
<% else %>
<div class="table-wrap">
<table class="table--cards">
  <thead>
    <tr>
      <th><%= t("admin.teams.index.name") %></th>
      <th><%= t("admin.teams.index.captain") %></th>
      <th><%= t("admin.teams.index.members") %></th>
      <th><%= t("admin.teams.index.actions") %></th>
    </tr>
  </thead>
  <tbody>
  <% @teams.each do |team| %>
    <tr>
      <td data-label="<%= t("admin.teams.index.name") %>"><%= team.name %></td>
      <%# A captainless team is the state this screen exists to repair, so the
          nil case is a label rather than a dereference. %>
      <td data-label="<%= t("admin.teams.index.captain") %>">
        <%= team.captain&.nickname || t("admin.teams.index.no_captain") %>
      </td>
      <%# One line however big the team: the first three, then a count. Every
          member is still listed in the captain picker in the last column. %>
      <% members = team.members.sort_by(&:id) %>
      <td class="members" data-label="<%= t("admin.teams.index.members") %>">
        <%= members.first(3).map(&:nickname).join(", ") %>
        <%# The rest behind a disclosure rather than dropped: a browser's
            find-in-page searches a closed <details> and opens it on a match,
            so every member stays findable by name. %>
        <% if members.size > 3 %>
          <details class="members-more">
            <summary><%= t("admin.teams_list.members_more", :count => members.size - 3) %></summary>
            <%= members.drop(3).map(&:nickname).join(", ") %>
          </details>
        <% end %>
      </td>
      <%# A real form, not a link: this app ships no Turbo and no rails-ujs,
          so link_to ..., method: :post would silently issue a GET against a
          POST-only route. A select cannot ride button_to either, which is
          why this is form_with rather than the button_to used elsewhere on
          the admin screens. %>
      <td>
        <div class="game-control">
          <%= link_to t("interventions.adjust.button"),
                      new_admin_team_adjustment_path(:team_id => team.id), :class => "btn" %>
          <% if team.members.any? %>
            <%= form_with url: set_captain_admin_team_path(team), method: :post do %>
              <%= label_tag "member_id_#{team.id}", t("admin.teams.index.captain"), :class => "visually-hidden" %>
              <%= select_tag :member_id,
                             options_from_collection_for_select(team.members, :id, :nickname, team.captain_id),
                             :id => "member_id_#{team.id}" %>
              <%= submit_tag t("admin.teams.index.set_captain"), :class => "btn" %>
            <% end %>
          <% end %>
        </div>
        <%# Rare and only ever on an empty, captainless team that never played,
            so it sits behind a disclosure rather than beside the everyday
            controls. A native <details>: no JavaScript. %>
        <% if team.deletable? %>
          <details class="row-more">
            <summary><%= t("admin.teams_list.more") %></summary>
            <%= button_to t("admin.teams.index.delete"), destroy_admin_team_path(team),
                          :method => :delete, :class => "btn btn--danger" %>
          </details>
        <% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
<% end %>
