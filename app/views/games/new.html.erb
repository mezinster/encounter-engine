<% content_for :head do %>
  <script src="/javascripts/calendar.js"></script>
  <script src="/javascripts/calendar-setup.js"></script>
  <script src="/javascripts/calendar-ru-UTF.js"></script>
  <link rel="stylesheet" href="/stylesheets/calendar.css">
<% end %>

<%= error_messages_for @game, header: "<h2>#{t("shared.error_header")}</h2>" %>

<% active_locale = params[:tab].presence_in(@game.available_locale_list) || @game.primary_locale %>
<%= render "shared/language_tabs", :game => @game, :record => @game,
                                   :fields => Game::TRANSLATABLE_FIELDS,
                                   :active => active_locale %>

<%= form_with model: @game, url: games_path do |f| %>
  <div class="field">
    <%= f.label :name, t("games.form.name") %>
    <% if active_locale == @game.primary_locale %>
      <%= f.text_field :name %>
    <% else %>
      <%= text_field_tag "game[translations][#{active_locale}][name]",
                         @game.translation_draft(:name, active_locale) %>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :description, t("games.form.description") %>
    <% if active_locale == @game.primary_locale %>
      <%= f.text_area :description %>
    <% else %>
      <%= text_area_tag "game[translations][#{active_locale}][description]",
                        @game.translation_draft(:description, active_locale) %>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :primary_locale, t("games.primary_locale_label") %>
    <%= f.select :primary_locale, I18n.available_locales.map { |l| [t("locales.#{l}"), l] } %>
  </div>
  <div class="field">
    <%= f.label :available_locale_list, t("games.available_locales_label") %>
    <% I18n.available_locales.each do |locale| %>
      <% is_primary = locale.to_s == @game.primary_locale.to_s %>
      <label>
        <% if is_primary %>
          <%= check_box_tag "game[available_locale_list][]", locale, true, :disabled => true %>
          <%= hidden_field_tag "game[available_locale_list][]", locale %>
        <% else %>
          <%= check_box_tag "game[available_locale_list][]", locale,
                            @game.available_locale_list.include?(locale.to_s) %>
        <% end %>
        <%= t("locales.#{locale}") %>
      </label>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :starts_at, t("games.form.starts_at") %>
    <%= f.text_field :starts_at %> <input id="calendar-switch" type="button" value="..." class="btn" />
  </div>
  <div class="field">
    <%= f.label :registration_deadline, t("games.form.registration_deadline") %>
    <%= f.text_field :registration_deadline %> <input id="calendar-switch2" type="button" value="..." class="btn" />
  </div>
  <div class="field">
    <%= f.label :max_team_number, t("games.form.max_team_number") %>
    <%= f.text_field :max_team_number %>
  </div>
  <div class="field">
    <%= f.label :visibility, t("games.form.is_draft") %>
    <%= f.check_box :visibility, {}, "draft", "listed" %>
  </div>
  <%= f.submit t("games.new.submit"), class: "btn btn--go" %>
<% end %>

<script type="text/javascript">
  Calendar.setup(
    {
      inputField  : "game_starts_at",
      ifFormat    : "%Y-%m-%d %H:%M",
      button      : "calendar-switch",
      showsTime   : true
    }
  );
  Calendar.setup(
  {
     inputField  : "game_registration_deadline",
     ifFormat    : "%Y-%m-%d %H:%M",
     button      : "calendar-switch2",
     showsTime   : true
  }
  );
</script>
