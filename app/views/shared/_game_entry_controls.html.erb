<% if game_entry %>
  <% case game_entry.status %>
  <% when "new" %>
    <%= t("shared.game_entry_controls.applied") %>
    <%= link_to t("shared.game_entry_controls.recall"), "/game_entries/recall/#{game_entry.id}" %>
  <% when "accepted"%> <%= t("shared.game_entry_controls.registered") %>
    <%= link_to t("shared.game_entry_controls.decline"), "/game_entries/cancel/#{game_entry.id}" %>
  <% when "recalled", "rejected", "canceled", nil %>
    <% if game.can_request? %>
      <%= link_to t("shared.game_entry_controls.reapply"), "/game_entries/reopen/#{game_entry.id}" %>
    <% else %>
      <%= t("shared.game_entry_controls.entries_exceeded") %>
    <% end %>
  <% end %>
<% else %>
  <% if !game.can_request? %>
    <%= t("shared.game_entry_controls.entries_exceeded") %>
  <% elsif game.registration_deadline and game.registration_deadline <= Time.now %>
    <%= t("shared.game_entry_controls.deadline_passed") %>
  <% else %>
    <%= link_to t("shared.game_entry_controls.apply"), new_game_entry_path(game_id: game.id, team_id: team.id) %>
  <% end %>
<% end %>
