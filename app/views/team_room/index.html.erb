<h2><%= t("team_room.index.title", name: @team.name) %></h2>

<fieldset class="card">
  <legend>
    <%= t("team_room.index.composition") %>
  </legend>

  <ul class="game-list">
  <% @team.members.each do |member| %>
    <li>
      <%= member.nickname %> <%= t("team_room.index.captain_suffix") if member.captain? %>
    </li>
  <% end %>
  </ul>

  <p>
    <%= link_to t("team_room.index.invite"), new_invitation_path, class: "btn" if @current_user.captain? %>
  </p>

  <%# Captain-only, so it cannot collide with the two frozen "Не капитан"
      scenarios in features/games/registration-to-game.feature, which assert
      that a non-captain sees neither "Подать заявку на регистрацию" nor a
      link "Отозвать" in this very region. Hidden mid-race (D1) and when the
      captain is the only member, since there would be nobody to hand to.

      A real form, not a link: this app ships no Turbo and no rails-ujs, so
      link_to with method: :post would silently issue a GET against a
      POST-only route. %>
  <% if @current_user.captain? && !@team.in_live_race? %>
    <% candidates = @team.members.reject { |member| member.id == @current_user.id } %>
    <% if candidates.any? %>
      <%= form_with url: hand_over_team_path(@team), method: :post do %>
        <%= select_tag :member_id,
                       options_from_collection_for_select(candidates, :id, :nickname) %>
        <%= submit_tag t("team_room.index.hand_over"), :class => "btn" %>
      <% end %>
    <% end %>
  <% end %>

  <%# Hidden exactly where TeamsController#leave refuses, so it is never a
      promise that cannot be kept: mid-race (D1), and for a captain who still
      has teammates -- they see the handover control above instead, and once
      they have handed over, this appears. A solo captain may leave (D5),
      taking the role with them.

      button_to rather than form_with: there is nothing to select. %>
  <% unless @team.in_live_race? %>
    <% if !@current_user.captain? || @team.members.count == 1 %>
      <p>
        <%= button_to t("team_room.index.leave"), leave_teams_path, :method => :post, :class => "btn" %>
      </p>
    <% end %>
  <% end %>

  <%# Where a member goes to move somewhere else. Link text is deliberately
      unrelated to the game-registration strings the two frozen "Не капитан"
      scenarios assert are absent from this region. %>
  <p>
    <%= link_to t("team_room.index.browse_teams"), teams_path, class: "btn" %>
  </p>
</fieldset>

<%= render "shared/current_games" %>

<%= render "dashboard/coming_games" %>

<%= render "dashboard/finished_games" %>
