<%# app/views/shared/_language_tabs.html.erb

    Locals:
      game    - the Game whose available_locale_list drives the tabs
      record  - the record being edited (for the per-tab missing count)
      fields  - the field names this form edits, e.g. Level::TRANSLATABLE_FIELDS
      active  - the currently selected locale

    Renders nothing for a single-locale game, so monolingual authors see the
    form exactly as it was before this feature existed.

    Deliberately its own :tab query param, distinct from the platform's
    pre-existing chrome switcher (?locale=, app/views/layouts/_header.html.erb,
    read by LocaleSelection on every request). Reusing ?locale= here would mean
    clicking the header's chrome switcher on a game/level form silently
    rebinds the inputs to a translation hash instead of the model's own
    columns -- an edit that looks like it saved but never touched the primary
    column. See Task 6 review round 2.
%>
<% if game.multilingual? %>
  <ul class="language-tabs">
    <% game.available_locale_list.each do |locale| %>
      <% missing = record.new_record? ? [] : record.missing_translated_fields(fields, locale) %>
      <li class="<%= "active" if locale == active %> <%= "incomplete" if missing.any? %>">
        <%# The language being edited is rendered as text, not a link. That is
            not only for looks: it means the active tab stays distinguishable
            even with no stylesheet, and an author can always tell which
            language the fields below are bound to. This strip shipped once with
            no CSS at all, which made every tab look identical -- the fields
            were correctly bound to whichever language the ?tab= param named,
            and the author had no way to know which one that was. %>
        <% label = capture do %>
          <%# "locales.<code>" is the key the header's language switcher already
              uses for a language's own name -- there is no separate
              "locale_name.*" key. %>
          <%= t("locales.#{locale}") %>
          <% if missing.any? %>
            <span class="missing-count"><%= t("games.translations.missing_count", :count => missing.size) %></span>
          <% end %>
        <% end %>
        <% if locale == active %>
          <span class="current"><%= label %></span>
        <% else %>
          <%= link_to label, url_for(request.query_parameters.merge(:tab => locale)) %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
