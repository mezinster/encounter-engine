<%# The whole test-run surface for one game, in the order the author reads it:
    who is testing, how to admit more, and then the actions.

    Rendered from TWO mutually exclusive places in games/show, and that is not
    duplication to tidy away. User#author_of? is strict (game.author_id ==
    id, no superadmin clause), so the author block does not render for an
    operator working on somebody else's game; putting this inside it would take
    the panel away from exactly the people the invitations feature exists to
    serve. The author gets it from inside that block, right after «Участвуют
    команды»; everyone else gets it from the call below the block, which for
    them also falls directly after «Участвуют команды».

    None of it exists outside a test: the caller guards on is_testing?, so
    unlike «Участвуют команды» -- which is always drawn, empty or not -- these
    blocks are absent rather than empty when no test is running. %>
<% may_manage = logged_in? &&
                (@game.created_by?(current_user) || current_user.superadmin?) %>

<% if may_manage %>
  <% admissions = TestAdmission.of_run(@game.current_run).includes(:team, :user) %>

  <%# A participants list in its own right, a sibling of «Заявки на
      регистрацию» and «Участвуют команды» rather than a line at the bottom of
      the admission form -- which is where an author went looking for a tester
      they had just invited and did not find one (reported 2026-08-15).
      Same shape as games/_teams and games/_game_entries: fieldset.card,
      legend, ul.game-list, a strong name with its actions in em. %>
  <fieldset class="card">
    <legend>
      <%= t("test_admissions.participants.legend") %>
    </legend>

    <% if admissions.any? %>
      <ul class="game-list">
        <% admissions.each do |admission| %>
          <li>
            <strong><%= admission.solo? ? admission.user&.nickname : admission.team.name %></strong>
            <%= t("test_admissions.panel.solo_marker") if admission.solo? %>
            <em><%= button_to t("test_admissions.panel.revoke"),
                              revoke_test_admission_path(:game_id => @game.id,
                                                         :id => admission.id) %></em>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p><%= t("test_admissions.panel.nobody_yet") %></p>
    <% end %>
  </fieldset>

  <%# Controls only -- the list above is where their result shows up. %>
  <fieldset class="card">
    <legend>
      <%= t("test_admissions.panel.legend") %>
    </legend>

    <%= form_tag test_admit_team_path(:game_id => @game.id) do %>
      <%= label_tag :name, t("test_admissions.panel.team_label") %>
      <%= text_field_tag :name %>
      <%= submit_tag t("test_admissions.panel.admit_team"), :class => "btn" %>
    <% end %>

    <%= form_tag test_admit_player_path(:game_id => @game.id) do %>
      <%= label_tag :nickname, t("test_admissions.panel.player_label") %>
      <%= text_field_tag :nickname %>
      <%= submit_tag t("test_admissions.panel.admit_player"), :class => "btn" %>
    <% end %>

    <p>
      <%= t("test_admissions.panel.link_label") %>
      <%# Rendered as text, not as an anchor: the author's job is to copy it
          into a chat, and a clickable link on their own page only invites them
          to follow it themselves. %>
      <code><%= test_invite_url(:game_id => @game.id,
                                :token => @game.current_run.test_token) %></code>
      <%= button_to t("test_admissions.panel.reset_token"),
                    reset_test_token_path(:game_id => @game.id), :class => "btn" %>
    </p>
  </fieldset>
<% end %>

<%# Last, because these are actions on the test rather than part of reading it.
    A tester sees only this row: both blocks above are may_manage only. %>
<div class="game-control">
  <%# Unguarded deliberately: ensure_author_if_game_is_testing means only the
      author, a superadmin or an admitted tester can be reading this page, and
      all three may legitimately open the play screen. %>
  <%= link_to t("games.show.start"), show_current_level_path(game_id: @game.id), class: "btn" %>
  <%# finish_test is behind ensure_author and deletes every passing and log
      line in the run, so a tester pressing it gets a 401. A button that
      cannot work should not be drawn. %>
  <%= button_to t("games.show.finish_test"), finish_test_game_path(@game), :class => "btn" if may_manage %>
</div>
