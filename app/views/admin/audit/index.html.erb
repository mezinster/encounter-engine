<%# app/views/admin/audit/index.html.erb %>
<h1><%= t("admin.audit.index.title") %></h1>

<div class="table-wrap">
<table class="table--cards">
  <thead>
    <tr>
      <th><%= t("admin.audit.index.when") %></th>
      <th><%= t("admin.audit.index.who") %></th>
      <th><%= t("admin.audit.index.what") %></th>
      <th><%= t("admin.audit.index.target") %></th>
      <th><%= t("admin.audit.index.details") %></th>
    </tr>
  </thead>
  <tbody>
  <% @entries.each do |entry| %>
    <tr>
      <td data-label="<%= t("admin.audit.index.when") %>"><%= l(entry.created_at, :format => :long) %></td>
      <td data-label="<%= t("admin.audit.index.who") %>">
        <%# Live actor first, so the entry stays clickable while they exist.
            The snapshot is the fallback: once the row is gone the label is
            the only thing that still says who did it. «неизвестно» remains
            for rows predating the snapshot whose actor has already left. %>
        <% if entry.actor %>
          <%= link_to entry.actor.nickname, admin_user_path(entry.actor) %>
        <% elsif entry.actor_label.present? %>
          <%= entry.actor_label %>
        <% else %>
          <%= t("admin.audit.index.unknown_actor") %>
        <% end %>
      </td>
      <%# The action name is chrome; a value nobody anticipated renders as
          itself rather than raising under raise_on_missing_translations. %>
      <td data-label="<%= t("admin.audit.index.what") %>"><%= t("admin.audit.index.action.#{entry.action}", :default => entry.action) %></td>
      <td data-label="<%= t("admin.audit.index.target") %>">
        <%# target_label is a snapshot, so it survives the target's deletion.
            Only link when the target still exists. %>
        <% if entry.target_type == "Game" && @live_games.include?(entry.target_id) %>
          <%= link_to entry.target_label, game_path(entry.target_id) %>
        <% elsif entry.target_type == "User" && @live_users.include?(entry.target_id) %>
          <%= link_to entry.target_label, admin_user_path(entry.target_id) %>
        <% else %>
          <%= entry.target_label %>
        <% end %>
      </td>
      <%# Free text captured at write time -- a team name, typically. Blank
          for every action that has no second subject. %>
      <td data-label="<%= t("admin.audit.index.details") %>"><%= entry.details %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>

<p><%= link_to t("admin.audit.index.back"), admin_dashboard_path %></p>
