<%# Rendered from games/index.html.erb and dashboard/_my_games.html.erb.
    Counts come from a helper rather than a controller ivar for that reason.

    .table--cards collapses to stacked cards below 48rem, using each cell's
    data-label to keep the column name; .table-wrap contains a long game name
    rather than letting it scroll the whole page sideways. %>
<% counts = game_team_counts(games) %>
<% gated_status = gated_play_status(games) %>
<% gated_counts = gated_participation_counts(games) %>

<div class="table-wrap">
<%# Deliberately NOT class="game-list". That class is used by nine other views
    (levels/_list, hints/_list, games/_teams, games/_game_entries,
    dashboard/_coming_games, dashboard/_finished_games, team_room/index,
    admin/users/show, layouts/_left_menu) and its only rules are
    `.game-list li` (screens.css:17) and `#drawer .game-list a`
    (layout.css:47) -- descendant selectors for <ul> markup that a <table>
    has no children to match. Carrying the class here would style nothing and
    mislead the next person into thinking it does. %>
<table class="table--cards">
  <thead>
    <tr>
      <th><%= t("games.list.name") %></th>
      <th><%= t("games.list.status") %></th>
      <th><%= t("games.list.starts_at") %></th>
      <th><%= t("games.list.ends_at") %></th>
      <th><%= t("games.list.participants") %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  <% games.each do |game| %>
    <tr>
      <td data-label="<%= t("games.list.name") %>">
        <strong><%= link_to game.name, game_path(game) %></strong>
      </td>
      <td data-label="<%= t("games.list.status") %>"><%= game_status_tag(game) %></td>
      <td data-label="<%= t("games.list.starts_at") %>">
        <%= l(game.starts_at, :format => :long) if game.starts_at %>
      </td>
      <td data-label="<%= t("games.list.ends_at") %>">
        <% if game.status == :finished && game.author_finished_at %>
          <%= l(game.author_finished_at, :format => :long) %><br>
        <% end %>
        <%= game_duration_text(game) %>
      </td>
      <%# Two figures answering two different questions -- how many teams were
          admitted against the cap, and how many of them actually started -- so
          they get a line each. Joined by a middot ("4 / 10 · играли: 3") they
          read as one statement, and left the reader to work out whether the 3
          was part of the 4 or a competing count.

          Deliberately NOT worded "из них играли: 3", which would say so
          outright: a TESTING game lets its author play with no accepted entry
          at all (GamePassingsController#may_start_passing?), so the second
          figure is not always a subset of the first and the claim would
          sometimes be false. %>
      <%# A commercial row answers different questions, so it gets different
          figures. "N / max" does not apply: max_team_number gates nothing on a
          gated game (neither pass issuing nor code redemption consults
          can_request?), and a game born gated can only ever read "0 / 100"
          while a converted one shows the stale free-era count it carried in.
          Nor does the running-vs-finished choice game_participation_text makes,
          because Game#status reports :available for the whole of a paid game's
          life -- teams mid-attempt and teams finished exist at the same moment,
          with no lifecycle instant to pick between them.

          The issued figure renders even at zero -- "nobody has bought yet" is
          what an operator opens this page to learn -- while the other two
          suppress, matching game_participation_text's own `if count > 0`. And
          they are still three separate figures rather than a sentence claiming
          a subset: a team that QUIT is in none of them. %>
      <td data-label="<%= t("games.list.participants") %>">
        <% if game.pass_required? %>
          <%= t("games.list.passes_issued", :count => gated_counts[:issued].fetch(game.id, 0)) %>
          <% playing   = gated_counts[:playing].fetch(game.id, 0) %>
          <% completed = gated_counts[:completed].fetch(game.id, 0) %>
          <%# Middot between these two, unlike the cap-and-participation pair
              above which deliberately keeps its figures on separate lines:
              these are peers, both counting attempts, so joining them states
              no relation the reader has to untangle. %>
          <% figures = [] %>
          <% figures << t("games.list.playing", :count => playing) if playing > 0 %>
          <% figures << t("games.list.completed", :count => completed) if completed > 0 %>
          <% if figures.any? %>
            <div class="participation"><%= figures.join(" · ") %></div>
          <% end %>
        <% else %>
          <%= counts[:registered].fetch(game.id, 0) %> / <%= game.max_team_number %>
          <% participation = game_participation_text(game, counts) %>
          <% if participation %>
            <div class="participation"><%= participation %></div>
          <% end %>
        <% end %>
      </td>
      <%# Every link below keeps its exact text, order and visibility
          condition: features/games/confirmed-teams-preview.feature,
          features/logs/live-channel.feature and features/logs/log.feature all
          reach this listing and click through by link text. New information
          is added AROUND these, never in place of them. %>
      <td>
        <em><%= link_to t("games.list.view"), game_path(game) %></em>
        <%# Gated only -- a scheduled row's link/message set is unchanged, and
            features/games/confirmed-teams-preview.feature and its siblings
            (see the comment above) only ever assert about scheduled rows'
            existing links, so this addition cannot touch them. %>
        <% if game.pass_required? %>
          <em><%= render "shared/current_games_status", game: game, game_entry: nil,
                                                          gated_live: gated_status.fetch(game.id, false) %></em>
        <% end %>
        <% if logged_in? and current_user.author_of?(game) %>
            <em><%= link_to t("shared.edit_short"), edit_game_path(game) %></em>
            <em><%= link_to t("games.list.stats"), game_stats_path(game) if game.started? %></em>
            <em><%= link_to t("games.list.live_channel"), show_live_channel_path(game.id) if game.started? %></em>
            <em><%= link_to t("games.list.full_log"), show_full_log_path(game.id) if game.started? %></em>
            <b><%= button_to t("games.list.end_game"), end_game_game_path(game) if (game.started? and !game.author_finished? and !game.is_testing?) %></b>
            <em><%= t("games.list.author_finished") if (game.started? and game.author_finished?) %></em>
        <% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
