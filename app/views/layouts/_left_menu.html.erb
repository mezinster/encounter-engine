<% if logged_in? %>
  <h3>
    <%= link_to current_user.nickname, dashboard_path %>
    <% if current_user.member_of_any_team? %>
      (<%= link_to current_user.team.name, team_room_path %>)
    <% end %>
  </h3>

  <ul class="game-list">
    <li>
      <%= link_to t("layout.left_menu.dashboard"), dashboard_path %>
    </li>

    <li>
      <%= link_to t("layout.left_menu.profile"), users_path %>
    </li>

    <li>
      <% if current_user.member_of_any_team? %>
        <%= link_to t("layout.left_menu.team_room"), team_room_path %>
      <% else %>
        <%= link_to t("layout.left_menu.create_team"), new_team_path %>
      <% end %>
    </li>

    <li>
      <%= link_to t("layout.left_menu.all_games"), games_path %>
    </li>

    <%# The team leaderboard. It was reachable only from the dashboard --
        and there only `unless member_of_any_team?` -- and from the team
        room, where «Все команды» reads as "go find another team" rather
        than "see the standings". Both of those framings are recruitment;
        this one is the ranking. %>
    <li>
      <%= link_to t("layout.left_menu.teams"), teams_path %>
    </li>

    <%# Inside the logged_in? branch, so current_user is guaranteed. The admin
        screens are scattered across four paths that are easy to forget and are
        linked from nowhere else -- the console links onward to the others, but
        only once you have found the console. %>
    <% if current_user.superadmin? %>
      <li>
        <strong><%= t("layout.left_menu.administration") %></strong>
      </li>

      <li>
        <%= link_to t("admin.dashboard.show.title"), admin_dashboard_path %>
      </li>

      <li>
        <%= link_to t("admin.games.index.title"), admin_games_path %>
      </li>

      <li>
        <%= link_to t("admin.users.index.title"), admin_users_path %>
      </li>

      <li>
        <%= link_to t("admin.dashboard.show.audit_log"), admin_audit_index_path %>
      </li>
    <% end %>

    <li>
      <%= link_to t("layout.left_menu.manual"), manual_path %>
    </li>

    <li>
      <%= link_to t("layout.left_menu.logout"), logout_path %>
    </li>
  </ul>
<% else %>
  <h3>
    <%= t("layout.left_menu.login_legend") %>
  </h3>

  <ul class="game-list">
    <li>
      <%= link_to t("layout.left_menu.login"), login_path %>
    </li>

    <li>
      <%= link_to t("layout.left_menu.signup"), signup_path %>
    </li>

    <li>
      <%= link_to t("layout.left_menu.teams"), teams_path %>
    </li>

    <li>
      <%= link_to t("layout.left_menu.manual"), manual_path %>
    </li>
  </ul>
<% end %>
