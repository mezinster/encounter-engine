<fieldset>
<% if logged_in? %>
  <legend>
    <%= link_to current_user.nickname, dashboard_path %>
    <% if current_user.member_of_any_team? %>
      (<%= link_to current_user.team.name, team_room_path %>)
    <% end %>
  </legend>

  <p>
    <%= link_to t("layout.left_menu.dashboard"), dashboard_path %>
  </p>

  <p>
    <%= link_to t("layout.left_menu.profile"), users_path %>
  </p>

  <p>
    <% if current_user.member_of_any_team? %>
      <%= link_to t("layout.left_menu.team_room"), team_room_path %>
    <% else %>
      <%= link_to t("layout.left_menu.create_team"), new_team_path %>
    <% end %>
  </p>

  <p>
    <%= link_to t("layout.left_menu.all_games"), games_path %>
  </p>

  <p>
    <%= link_to t("layout.left_menu.logout"), logout_path %>
  </p>
<% else %>
  <legend>
    &nbsp;<%= t("layout.left_menu.login_legend") %>&nbsp;
  </legend>

  <p>
    <%= link_to t("layout.left_menu.login"), login_path %>
  </p>

  <p>
    <%= link_to t("layout.left_menu.signup"), signup_path %> <br />
  </p>
<% end %>
