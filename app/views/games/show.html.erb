<h2>
  <%= t("games.show.title") %> "<strong><%= @game.name %></strong>"
</h2>

<% if @game.draft? %>
  <div class="is-draft-message"><%= t("games.show.draft_label") %></div>
<% end %>


<p>
  <em><%= t("games.show.author_label") %></em> - <strong><%= @game.author.nickname %></strong>
</p>

<p>
  <% unless @game.starts_at.nil? %>
    <em><%= t("games.show.starts_at_label") %></em>: <%= l(@game.starts_at, format: :short) %>
  <% else %>
    <%= t("games.show.starts_at_not_set") %>
  <% end %>
</p>
<p>
  <% unless @game.registration_deadline.nil? %>
    <em><%= t("games.show.registration_deadline_label") %></em>: <%= l(@game.registration_deadline, format: :short) %>
  <% else %>
    <%= t("games.show.registration_deadline_not_set") %>
  <% end %>
</p>

<p>
  <em><%= t("games.show.description_label") %></em>
</p>

<p>
  <%= @game.description %>
</p>
<p>
  <em><%= t("games.show.max_team_number_label") %></em>
</p>
<p>
  <%= @game.max_team_number %>
</p>

<br />

<% if logged_in? and @current_user.author_of?(@game) %>

  <fieldset>
    <legend>
      <%= t("games.show.levels_legend") %>
    </legend>

    <p>
      <%= render "levels/list", levels: @game.levels %>
    </p>

    <p>
      <%= link_to t("games.show.add_level"), new_game_level_path(@game) if ! @game.started? %>
    </p>
  </fieldset>
  <br/>
      <%= render "games/game_entries", game_entries: @game_entries %>

    <br/>

    <%= render "games/teams", teams: @teams %>
  <br />
  <p>
    <%= link_to t("games.show.edit_link"), edit_game_path(@game) if ! @game.started? %>
  </p>

  <p>
    <%= link_to t("games.show.delete_link"), delete_game_path(@game) %> <br />
  </p>

<% end %>

<script type="text/javascript" src="/javascripts/jquery-1.3.2.min.js"></script>
<%= render "shared/countdown" %>
<div id="countdown-example"></div>

<script type="text/javascript">
  <% unless @game.starts_at.nil? %>
    var date = new Date(<%= (@game.starts_at + 1).strftime("%Y,%m-1,%d,%H,%M,%S") %>);
  <% end %>

  $("#countdown-example").countdown(date,{
    prefix:'<%= t("games.show.countdown_prefix") %>'
  });
</script>

<br />
<%= render "teams", teams: @teams if (!logged_in?) || (logged_in? && !@current_user.author_of?(@game)) %>

<% if @game.draft? and !@game.started? and @game.levels and @game.levels.count > 0 %>
   <%= link_to t("games.show.start_test"), "/games/start_test/#{@game.id}" %>
<% end %>

<% if @game.is_testing? %>
   <%= link_to t("games.show.start"), show_current_level_path(game_id: @game.id) %>
   <br />
   <%= link_to t("games.show.finish_test"), "/games/finish_test/#{@game.id}" %>
<% end %>
