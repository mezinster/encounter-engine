<% page_title t("titles.live_channel"), game: @game %>
<h2><%= t("logs.show_live_channel.title", name: @game.name) %></h2>

<%= render "shared/run_context" %>
<%= render "shared/live_status" %>

<div class="table-wrap" id="livechannel-live" data-live>
<table id="livechannel" class="table--cards table--compact">
  <thead>
    <tr>
      <th><%= t("logs.show_live_channel.time") %></th>
      <th><%= t("logs.show_live_channel.team") %></th>
      <th><%= t("logs.show_live_channel.level") %></th>
      <th><%= t("logs.show_live_channel.code") %></th>
    </tr>
  </thead>
  <tbody>
    <%# Newest first is now ORDER BY time DESC in the controller, which is what
        the comparator this replaced already produced: it returned 1 when
        left.time <= right.time. Sorting in SQL is what lets the page stop
        loading every log for the run. %>
    <% @logs.each do |log| %>
      <tr>
        <td class="lc-time" data-label="<%= t("logs.show_live_channel.time") %>"><%= log.time.strftime("%H:%M:%S") %></td>
        <td class="lc-team" data-label="<%= t("logs.show_live_channel.team") %>"><%= log.team_record&.name || log.team %></td>
        <td class="lc-level" data-label="<%= t("logs.show_live_channel.level") %>"><%= log.level_record&.name || log.level %></td>
        <td class="lc-code" data-label="<%= t("logs.show_live_channel.code") %>"><%= log.answer %></td>
        </tr>
    <% end %>
  </tbody>
</table>
<%# features/logs/live-channel.feature:46 (frozen) expects the column headings on an
    empty channel, so the table and its header stay; the card goes under them. %>
<% if @logs.empty? %>
<%= render "shared/empty_state", :title => t("empty_states.live_channel.title"), :text => t("empty_states.live_channel.text") %>
<% end %>
<%= render "shared/pager", :current => @page, :total => @total_pages %>
</div>
