<h2>
  <%= t("questions.new.title") %> "<strong><%= @level.name %></strong>"
</h2>

<p>
  <em>(<%= t("questions.new.game_prefix") %> "<%= link_to @game.name, game_path(@game) %>")</em>
</p>

<br />

<%= error_messages_for @answer, header: "<h2>#{t("shared.error_header")}</h2>" %>

<% active_locale = params[:tab].presence_in(@level.game.available_locale_list) || @level.game.primary_locale %>
<%= render "shared/language_tabs", :game => @level.game, :record => @question,
                                   :fields => Question::TRANSLATABLE_FIELDS,
                                   :active => active_locale %>

<%= form_with model: @question, url: game_level_questions_path(@game, @level) do |f| %>
  <p>
    <%# The answers field is not branched by locale: answer codes are shared
        across languages by design (see the help text below), unlike
        Question::TRANSLATABLE_FIELDS' :questions field, which has no editing
        UI on this form. %>
    <%= f.label :correct_answer, t("questions.new.code_label") %>
    <%= f.text_field :correct_answer %>
  </p>
  <p class="hint-text"><%= t("questions.answers_are_shared") %></p>
  <%= f.submit t("questions.new.submit") %>
  <em><%= link_to t("shared.cancel"), game_level_path(@game, @level) %></em>
<% end %>
