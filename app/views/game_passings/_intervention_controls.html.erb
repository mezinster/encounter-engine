<%# app/views/game_passings/_intervention_controls.html.erb
    One team's operator controls, shown inside that team's disclosure panel.
    Every control posts to a named action -- there is deliberately no field
    that writes a column directly. %>
<div class="panel team-panel">
  <div class="team-panel-actions">
    <%= form_with :url => move_team_path(:game_id => game_passing.game_id, :team_id => game_passing.team_id),
                  :method => :post, :local => true do |f| %>
      <%# Level names are author-written content: rendered verbatim, never
          through t(). %>
      <%= f.select :level_id, levels.map { |level| [ level.name, level.id ] } %>
      <%= f.submit t("game_passings.index.move"), :class => "btn" %>
    <% end %>

    <% if game_passing.exited? %>
      <%= button_to t("game_passings.index.reinstate"),
                    reinstate_team_path(:game_id => game_passing.game_id, :team_id => game_passing.team_id),
                    :method => :post, :class => "btn" %>
    <% end %>

    <% unless game_passing.finished? %>
      <%= button_to t("game_passings.index.reset_clock"),
                    reset_team_clock_path(:game_id => game_passing.game_id, :team_id => game_passing.team_id),
                    :method => :post, :class => "btn btn--danger" %>
    <% end %>

    <%# The same two conditions the captain's own button carries in
        show_current_level.html.erb, and for the same reason: skip_level! is
        shared, so a button offered outside them can only ever come back as
        "Это действие сейчас невозможно". max_skips defaults to 0 and IS the
        feature switch, so without this the control appeared on every team of
        every game that exists today. %>
    <%# The three conditions skip_level! itself refuses on, so the control is
        never offered when its only possible outcome is a refusal. The run-state
        clause was missing: an ended or exited run kept the button. %>
    <% if game_passing.game.skips_allowed? && game_passing.skips_left.positive? &&
          !game_passing.finished? && !game_passing.interrupted? %>
      <%= button_to t("interventions.skip_level"),
                    skip_team_level_path(:game_id => game_passing.game_id, :team_id => game_passing.team_id),
                    :method => :post, :class => "btn" %>
    <% end %>

    <%# Unconditional, deliberately: unlike a skip there is no cap and no
        per-game setting, so there is no state in which an adjustment is
        unavailable. %>
    <%= link_to t("interventions.adjust.button"),
                new_team_adjustment_path(:game_id => game_passing.game_id, :team_id => game_passing.team_id),
                :class => "btn" %>
  </div>
</div>
