<% if current_user.member_of_any_team? %>
  <% unless Game.started.empty? %>
    <fieldset class="card">
      <legend>
        <%= t("shared.current_games.legend") %>
      </legend>

      <%# A gated game reaches this widget whenever its start date happens to
          be past -- Game#started? reads starts_at and knows nothing about
          access_mode -- so gated_play_status is needed here too, computed
          once for the whole widget rather than per row (see GamesHelper). %>
      <% running = Game.started - Game.finished %>
      <% gated_status = gated_play_status(running) %>
      <% running.each do |game| %>
        <div id="game-<%= game.id %>">
          <% unless game.is_testing? %>
          <%= t("shared.current_games.started") %> "<%= link_to game.name, game_path(game) %>" |
              <% if current_user.team.finished?(game) or game.created_by?(current_user) %>
                <%= link_to t("shared.current_games.view_results"), game_passings_show_results_path(game_id: game.id) %>
              <% else %>
                <% if game.levels && game.levels.count > 0 %>
                  <%# game_entry stays nil on a gated game, deliberately:
                      _current_games_status tests game_entry FIRST, so an
                      entry left over from before the game was gated would
                      otherwise offer "Играть!" to a team holding no pass --
                      and an entry authorises nothing on a gated game
                      (GameEntriesController#ensure_game_is_not_gated).
                      gated_live is what that branch actually reads; without
                      it the partial defaults to "no access" and sent a team
                      holding a live pass off to redeem a code they do not
                      have. %>
                  <% @game_entry = game.pass_required? ? nil : GameEntry.of(@team, game.current_run) %>
                  <%= render "shared/current_games_status", game_entry: @game_entry, game: game,
                                                            gated_live: gated_status.fetch(game.id, false) %>
                <% else %>
                  <%= t("shared.current_games.no_levels") %>
                <% end %>
              <% end %>
           <% end %>
        </div>
      <% end %>
    </fieldset>
  <% end %>
<% end %>
