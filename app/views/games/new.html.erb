<% page_title t("titles.game_new") %>
<%= error_messages_for @game, header: "<h2>#{t("shared.error_header")}</h2>" %>

<% active_locale = params[:tab].presence_in(@game.available_locale_list) || @game.primary_locale %>
<%= render "shared/language_tabs", :game => @game, :record => @game,
                                   :fields => Game::TRANSLATABLE_FIELDS,
                                   :active => active_locale %>

<%= form_with model: @game, url: games_path do |f| %>
  <div class="field">
    <%= f.label :name, t("games.form.name") %>
    <% if active_locale == @game.primary_locale %>
      <%= f.text_field :name %>
    <% else %>
      <%= text_field_tag "game[translations][#{active_locale}][name]",
                         @game.translation_draft(:name, active_locale) %>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :description, t("games.form.description") %>
    <% if active_locale == @game.primary_locale %>
      <%= f.text_area :description %>
    <% else %>
      <%= text_area_tag "game[translations][#{active_locale}][description]",
                        @game.translation_draft(:description, active_locale) %>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :primary_locale, t("games.primary_locale_label") %>
    <%= f.select :primary_locale, I18n.available_locales.map { |l| [t("locales.#{l}"), l] } %>
  </div>
  <div class="field">
    <%= f.label :available_locale_list, t("games.available_locales_label") %>
    <% I18n.available_locales.each do |locale| %>
      <% is_primary = locale.to_s == @game.primary_locale.to_s %>
      <label class="check">
        <% if is_primary %>
          <%= check_box_tag "game[available_locale_list][]", locale, true, :disabled => true %>
          <%= hidden_field_tag "game[available_locale_list][]", locale %>
        <% else %>
          <%= check_box_tag "game[available_locale_list][]", locale,
                            @game.available_locale_list.include?(locale.to_s) %>
        <% end %>
        <span><%= t("locales.#{locale}") %></span>
      </label>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :starts_at, t("games.form.starts_at") %>
    <%= f.datetime_local_field :starts_at, :include_seconds => false %>
    <%= render "games/timezone_hint" %>
  </div>
  <div class="field">
    <%= f.label :registration_deadline, t("games.form.registration_deadline") %>
    <%= f.datetime_local_field :registration_deadline, :include_seconds => false %>
    <%= render "games/timezone_hint" %>
  </div>
  <div class="field">
    <%= f.label :max_team_number, t("games.form.max_team_number") %>
    <%= f.text_field :max_team_number %>
  </div>
  <div class="field">
    <label class="check"><%= f.check_box :visibility, {}, "draft", "listed" %> <span><%= t("games.form.is_draft") %></span></label>
  </div>
  <div class="field">
    <label class="check"><%= f.check_box :points_enabled %> <span><%= t("games.form.points_enabled") %></span></label>
  </div>
  <div class="field">
    <%= f.label :level_completion_points, t("games.form.level_completion_points") %>
    <%= f.number_field :level_completion_points, :min => 0 %>
  </div>
  <div class="field">
    <%= f.label :game_completion_points, t("games.form.game_completion_points") %>
    <%= f.number_field :game_completion_points, :min => 0 %>
  </div>
  <div class="field">
    <%= f.label :max_skips, t("games.form.max_skips") %>
    <%= f.number_field :max_skips, :min => 0 %>
  </div>
  <div class="field">
    <%= f.label :skip_points_fine, t("games.form.skip_points_fine") %>
    <%= f.number_field :skip_points_fine, :min => 0 %>
  </div>
  <div class="field">
    <%= f.label :skip_time_penalty, t("games.form.skip_time_penalty") %>
    <%= f.number_field :skip_time_penalty, :min => 0 %>
  </div>
  <%# Operator/superadmin territory only -- see User#may_operate_commercial?
      and GamesController#game_attributes, which strips this key from
      anyone else's params so a hand-crafted POST can't set it either. A
      SINGLE field, deliberately: a later sub-project adds author-settable
      scoring options to this same form, and a "commercial settings" section
      built now would either wrongly gate those behind this predicate or
      have to be split apart later. %>
  <% if logged_in? && current_user.may_operate_commercial? %>
    <div class="field">
      <%= f.label :access_mode, t("games.form.access_mode") %>
      <%= f.select :access_mode, Game::ACCESS_MODES.map { |m| [t("games.form.access_mode_#{m}"), m] } %>
    </div>
  <% end %>
  <%= f.submit t("games.new.submit"), class: "btn btn--go" %>
<% end %>
