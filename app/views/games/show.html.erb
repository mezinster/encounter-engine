<% content_locale = content_locale_for(@game) %>

<h2 class="page-title">
  <%= t("games.show.title") %> "<strong><%= @game.translated(:name, content_locale) %></strong>"
</h2>

<% if @game.draft? %>
  <div class="is-draft-message"><%= t("games.show.draft_label") %></div>
<% end %>

<%# Directly under the title, because the title itself is translated content:
    a reader who wonders why the name reads Turkish finds the control that
    says so in the same glance. Signed-in only -- the preference is stored per
    user, and a guest's content locale already follows the header switcher. %>
<% if logged_in? %>
  <%= render "shared/content_language_switcher", :game => @game,
             :switch_path => ->(locale) { set_content_locale_game_path(@game, :locale => locale) } %>
<% end %>

<div class="panel">
  <p>
    <em><%= t("games.show.author_label") %></em> - <strong><%= @game.author.nickname %></strong>
  </p>

  <p>
    <% unless @game.starts_at.nil? %>
      <em><%= t("games.show.starts_at_label") %></em>: <%= l_with_zone(@game.starts_at, format: :short) %>
    <% else %>
      <%= t("games.show.starts_at_not_set") %>
    <% end %>
  </p>
  <p>
    <% unless @game.registration_deadline.nil? %>
      <em><%= t("games.show.registration_deadline_label") %></em>: <%= l_with_zone(@game.registration_deadline, format: :short) %>
    <% else %>
      <%= t("games.show.registration_deadline_not_set") %>
    <% end %>
  </p>

  <p>
    <em><%= t("games.show.description_label") %></em>
  </p>

  <p>
    <%= with_newlines(@game.translated(:description, content_locale)) %>
  </p>
  <p>
    <em><%= t("games.show.max_team_number_label") %></em>
  </p>
  <p>
    <%= @game.max_team_number %>
  </p>
</div>

<% if logged_in? and @current_user.author_of?(@game) %>

  <% if @game.author == current_user %>
    <%= render "games/missing_translations", :game => @game %>
  <% end %>

  <fieldset class="card">
    <legend>
      <%= t("games.show.levels_legend") %>
    </legend>

    <%= render "levels/list", levels: @game.levels %>

    <p>
      <%= link_to t("games.show.add_level"), new_game_level_path(@game), class: "btn" if ! @game.started? %>
      <%# Same condition as adding a single level, because the importer rides
          the same guards: an author cannot bulk-import into a started game
          either. The label deliberately shares no wording with "Добавить
          новое задание", whose absence two frozen scenarios in
          features/levels/create-level.feature assert for non-authors. %>
      <%= link_to t("games.show.import_questions"), new_game_quiz_import_path(@game), class: "btn" if ! @game.started? %>
    </p>
  </fieldset>

  <%= render "games/game_entries", game_entries: @game_entries %>

  <%= render "games/teams", teams: @teams %>

  <%# Directly after the teams list, and above the hand-over and delete rows:
      an author who has just admitted a tester looks for them where the other
      participants are. See the partial for why this is rendered here AND
      below the author block rather than in one place. %>
  <%= render "test_admissions" if @game.is_testing? %>

  <%# Rendered only when the action would actually allow it, matching the
      import link above: offering a control the action refuses is a promise the
      page cannot keep. The two conditions are GamesController#hand_over's two
      author-side refusals.

      Its own fieldset, above the edit and delete rows, so the button that
      gives the game away is never the one next to the button the author meant
      to press. %>
  <% unless @game.editing_locked? || (@game.started? && !@game.author_finished?) %>
    <fieldset class="card">
      <legend><%= t("games.show.hand_over_legend") %></legend>

      <%# A real form: this app ships neither Turbo nor rails-ujs. %>
      <%= form_with url: hand_over_game_path(@game), method: :post do %>
        <p>
          <%= label_tag :nickname, t("games.show.hand_over_label") %>
          <%= text_field_tag :nickname, nil, :autocomplete => "off" %>
        </p>
        <p>
          <%= submit_tag t("games.show.hand_over_button"), :class => "btn" %>
        </p>
      <% end %>
    </fieldset>
  <% end %>

  <%# The author's own actions get a row of their own, separate from the
      entries/teams management above -- and the destructive one (delete)
      gets a second row of its own again, so it is never the button next to
      the one the author meant to press. %>
  <div class="game-control">
    <%= link_to t("games.show.edit_link"), edit_game_path(@game), class: "btn" if ! @game.started? %>
    <%= link_to t("game_files.index.title_short"), game_game_files_path(@game), class: "btn" %>
  </div>

  <p class="danger-row">
    <%= button_to t("games.show.delete_link"), delete_game_path(@game), :method => :delete, :class => "btn btn--danger" %>
  </p>

<% end %>

<script type="text/javascript" src="/javascripts/jquery-1.3.2.min.js"></script>
<%= render "shared/countdown" %>
<div id="countdown-example"></div>

<script type="text/javascript">
  <% unless @game.starts_at.nil? %>
    <%# Milliseconds since the epoch, not a local-time tuple. The old form
        emitted bare numbers that new Date(y,m,d,...) reads in the BROWSER's
        zone while the server wrote them in its own -- so the countdown was
        already wrong for every user whose browser zone differed from the
        instance's, and per-user timezones would have put that error directly
        under a correctly-labelled start time on the same page. %>
    var date = new Date(<%= (@game.starts_at + 1).to_i * 1000 %>);
  <% end %>

  $("#countdown-example").countdown(date,{
    prefix: <%= t("games.show.countdown_prefix").to_json.html_safe %>
  });
</script>

<%= render "teams", teams: @teams if (!logged_in?) || (logged_in? && !@current_user.author_of?(@game)) %>

<% if @game.draft? and !@game.started? and @game.levels and @game.levels.count > 0 %>
   <p><%= button_to t("games.show.start_test"), start_test_game_path(@game), :class => "btn" %></p>
<% end %>

<%# The other of the two mutually exclusive call sites -- superadmins and
    admitted testers, for whom the author block above does not render, so this
    still falls directly after their «Участвуют команды» on line 141. The
    author was served inside that block; excluding them here is what stops the
    panel appearing twice. %>
<% if @game.is_testing? && !(logged_in? && @current_user.author_of?(@game)) %>
   <%= render "test_admissions" %>
<% end %>
