<h1><%= t("admin.users.index.title") %></h1>

<div class="table-wrap">
<table class="table--cards">
  <thead>
    <tr>
      <th><%= t("admin.users.index.nickname") %></th>
      <th><%= t("admin.users.index.email") %></th>
      <th><%= t("admin.users.index.team") %></th>
      <th><%= t("admin.users.index.locale") %></th>
      <th><%= t("admin.users.index.signed_up") %></th>
      <th><%= t("admin.users.index.role") %></th>
    </tr>
  </thead>
  <tbody>
  <% @users.each do |user| %>
    <tr>
      <%# Nicknames, emails and team names are user-written content and render
          verbatim; every label around them is chrome through t(). %>
      <td data-label="<%= t("admin.users.index.nickname") %>"><%= link_to user.nickname, admin_user_path(user) %></td>
      <td data-label="<%= t("admin.users.index.email") %>"><%= user.email %></td>
      <td data-label="<%= t("admin.users.index.team") %>"><%= user.team&.name %></td>
      <td data-label="<%= t("admin.users.index.locale") %>"><%= user.locale %></td>
      <td data-label="<%= t("admin.users.index.signed_up") %>"><%= l(user.created_at, :format => :long) %></td>
      <td data-label="<%= t("admin.users.index.role") %>">
        <% if user.superadmin? %><span class="tag"><%= t("admin.users.index.superadmin") %></span><% end %>
        <% if user.operator? %><span class="tag"><%= t("admin.users.index.operator") %></span><% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>

<p><%= link_to t("admin.users.index.back"), admin_dashboard_path %></p>
