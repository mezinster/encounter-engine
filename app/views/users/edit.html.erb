<h2><%= t("users.edit.title", nickname: @current_user.nickname) %></h2>
<br>

<%= error_messages_for @user, header: "<h2>#{t("shared.error_header")}</h2>" %>

<%= form_with model: @user, url: user_path(@user) do |f| %>
  <p>
    <%= f.label :nickname, t("users.edit.nickname_label") %>
    <%= f.text_field :nickname %>
  </p>
  <p>
    <%= f.label :date_of_birth, t("users.edit.date_of_birth_label") %>
    <%= f.text_field :date_of_birth %>
  </p>
  <p>
    <%= f.label :icq_number, t("users.edit.icq_label") %>
    <%= f.text_field :icq_number %>
  </p>
  <p>
    <%= f.label :jabber_id, t("users.edit.jabber_label") %>
    <%= f.text_field :jabber_id %>
  </p>
  <p>
    <% if @user.captain? %>
      <%= f.label :phone_number, t("users.edit.phone_label") %>
      <%= f.text_field :phone_number %>
    <% end %>
  </p>
  <br/>
  <p>
    <%= f.label :password, t("users.edit.password_label") %>
    <%= f.text_field :password %>
  </p>
  <p>
    <%= f.label :password_confirmation, t("users.edit.password_confirmation_label") %>
    <%= f.text_field :password_confirmation %>
  </p>
  <%= f.submit t("users.edit.submit") %>
  <em><%= link_to t("shared.cancel"), users_path %></em>
<% end %>
