<%# Game.notstarted takes no account of access_mode -- Game#started? reads
    starts_at alone -- so a gated game lands in this widget beside the
    scheduled ones, and gets the treatment games/_list already gives it: the
    redemption link, never an application button, because an entry on a gated
    game authorises nothing (GameEntriesController#ensure_game_is_not_gated).

    Held in a local and read twice, for the legend and the loop, rather than
    calling the selector twice: it loads every visible game. gated_play_status
    is likewise computed once for the whole widget rather than per row -- see
    its own comment in GamesHelper. %>
<% games = Game.notstarted %>
<% gated_status = gated_play_status(games) %>
<fieldset id="coming" class="card">
  <legend>
    <%= t("dashboard.coming_games.legend", count: games.count) %>
  </legend>
  <ul class="game-list">
  <% games.each do |game | %>
    <li>
      <%= t("dashboard.coming_games.upcoming") %> <b><%= link_to game.name, game_path(game) %></b> |
      <% if game.created_by?(current_user) %>
        <b><%= t("dashboard.coming_games.you_are_author") %></b>
      <% else %>
        <% if game.pass_required? %>
          <%= render "shared/current_games_status", game: game, game_entry: nil,
                                                    gated_live: gated_status.fetch(game.id, false) %>
        <% elsif @current_user.captain? %>
          <% @game_entry = GameEntry.of(@team, game.current_run) %>
          <%= render "shared/game_entry_controls", game_entry: @game_entry, game: game, team: @team %>
        <% end %>
        <%= link_to t("dashboard.coming_games.enter"), game_path(game) %>
      <% end %>
    </li>
  <% end %>
  </ul>
</fieldset>
