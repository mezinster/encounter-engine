<% page_title t("titles.translation_review"), game: @game %>
<h2><%= t("translations.review.heading", :game => @game.name) %></h2>

<%= button_to t("translations.review.accept_all"),
              accept_all_game_translation_run_proposals_path(@game, @run),
              :class => "btn btn--go" %>

<table class="proposals table--cards">
  <thead>
    <tr>
      <th><%= t("translations.review.columns.locale") %></th>
      <th><%= t("translations.review.columns.field") %></th>
      <th><%= t("translations.review.columns.source") %></th>
      <th><%= t("translations.review.columns.proposal") %></th>
      <th><%= t("translations.review.columns.state") %></th>
    </tr>
  </thead>
  <tbody>
  <% @proposals.each do |proposal| %>
    <tr class="<%= "flagged" if proposal.flagged? %>">
      <td class="locale" data-label="<%= t("translations.review.columns.locale") %>"><%= t("locales.#{proposal.locale}") %></td>
      <td class="field" data-label="<%= t("translations.review.columns.field") %>"><%= @game.label_for(proposal.translatable, proposal.field) %></td>
      <%# Rendered as text, never as HTML. Author-written game content is
          escaped everywhere in this application and a translation of it is
          no different. %>
      <td class="source" data-label="<%= t("translations.review.columns.source") %>"><%= proposal.source_text %></td>
      <td class="proposal" data-label="<%= t("translations.review.columns.proposal") %>">
        <%# Accept and Reject are offered ONLY while the proposal is pending.
            Both actions scope their lookup to .pending, so a button on an
            already-reviewed row raises RecordNotFound -- and this app installs
            no rescue_from for it, so that is a 404 in production reached by
            clicking a control the page itself drew. A reviewed row shows what
            was decided instead. %>
        <% if proposal.state == TranslationProposal::PENDING %>
          <%= form_with url: accept_game_translation_run_proposal_path(@game, @run, proposal),
                        method: :post do %>
            <%= text_area_tag "proposed_text", proposal.proposed_text, :rows => 3 %>
            <% if proposal.flagged? %>
              <ul class="flags">
                <% proposal.flag_list.each do |flag| %>
                  <li class="tag tag--danger"><%= t("translations.flags.#{flag}") %></li>
                <% end %>
              </ul>
            <% end %>
            <%= submit_tag t("translations.review.accept"), :class => "btn btn--go" %>
          <% end %>
          <%= button_to t("translations.review.reject"),
                        reject_game_translation_run_proposal_path(@game, @run, proposal),
                        :class => "btn" %>
        <% else %>
          <%# The machine's words stay visible after review. If the reviewer
              edited before accepting, both are shown -- that pairing is the
              audit trail the design says lives only in this table. %>
          <p class="proposed"><%= proposal.proposed_text %></p>
          <% if proposal.edited? %>
            <p class="accepted">
              <strong><%= t("translations.review.edited") %></strong>
              <%# The span, not the <p>, keeps line breaks: pre-wrap on the <p>
                  would also render this template's own newlines and indentation. %>
              <span class="accepted-text"><%= proposal.accepted_text %></span>
            </p>
          <% end %>
        <% end %>
      </td>
      <td class="state" data-label="<%= t("translations.review.columns.state") %>"><%= t("translations.review.state.#{proposal.state}") %></td>
    </tr>
  <% end %>
  </tbody>
</table>

<%# Below the table, not beside "accept everything unflagged" at the top:
    the flagged rows and their reasons are what a reviewer is agreeing to,
    and they have just scrolled past them to reach this. That reading IS the
    confirmation step -- there is no dialog, this app has no rails-ujs -- so
    the count goes in the label, making the button a statement about a
    specific number of proposals rather than a vague "and the rest". %>
<% flagged_count = @proposals.count(&:bulk_acceptable_flagged?) %>
<% if flagged_count > 0 %>
  <%= button_to t("translations.review.accept_flagged", :count => flagged_count),
                accept_flagged_game_translation_run_proposals_path(@game, @run),
                :class => "btn" %>
<% end %>
