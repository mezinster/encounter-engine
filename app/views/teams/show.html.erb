<h1><%= @team.name %></h1>

<p><%= t("teams.show.balance") %>: <%= @team.balance %></p>

<h2><%= t("teams.show.games") %></h2>

<div class="table-wrap">
<table class="table--cards">
  <thead>
    <tr>
      <th><%= t("teams.show.game") %></th>
      <th><%= t("teams.show.started") %></th>
      <th><%= t("teams.show.finished") %></th>
      <th><%= t("teams.show.points") %></th>
    </tr>
  </thead>
  <tbody>
  <% @passings.each do |passing| %>
    <tr>
      <%# Never `passing.game.name` directly: this page is public and a draft
          or withdrawn game's title is not. See
          TeamsController#nameable_game_ids -- the row stays either way, so
          the totals below still add up in public. %>
      <td data-label="<%= t("teams.show.game") %>"><%= game_title_for_viewer(passing.game) %></td>
      <td data-label="<%= t("teams.show.started") %>"><%= l(passing.created_at, :format => :long) %></td>
      <%# `completed?`, not finished_at: exit! stamps finished_at AND status
          "exited", so asking the column alone printed a finish time for a run
          the chart counts as never completed -- and against which no
          completion award was ever written (P4). The three branches are
          GamePassing's three outcomes, in the same order. %>
      <td data-label="<%= t("teams.show.finished") %>">
        <% if passing.completed? %>
          <%= l(passing.finished_at, :format => :long) %>
        <% elsif passing.interrupted? %>
          <%= t("teams.show.abandoned") %>
        <% else %>
          <%= t("teams.show.unfinished") %>
        <% end %>
      </td>
      <td data-label="<%= t("teams.show.points") %>"><%= @per_attempt.fetch(passing.id, 0) %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>

<h2><%= t("teams.show.ledger") %></h2>

<div class="table-wrap">
<table class="table--cards">
  <thead>
    <tr>
      <th><%= t("teams.show.when") %></th>
      <th><%= t("teams.show.game") %></th>
      <th><%= t("teams.show.reason") %></th>
      <th><%= t("teams.show.note") %></th>
      <th><%= t("teams.show.amount") %></th>
    </tr>
  </thead>
  <tbody>
  <% @transactions.each do |row| %>
    <tr>
      <td data-label="<%= t("teams.show.when") %>"><%= l(row.created_at, :format => :long) %></td>
      <td data-label="<%= t("teams.show.game") %>"><%= game_title_for_viewer(row.game) %></td>
      <%# Rendered from a fixed set, never interpolated from the column: an
          unrecognised reason must not print "translation missing" on a public
          page. See the design, §6. %>
      <td data-label="<%= t("teams.show.reason") %>">
        <%= PointTransaction::REASONS.include?(row.reason) ? t("teams.show.reasons.#{row.reason}") : row.reason %>
      </td>
      <%# Operator-authored free text on a public page: rendered verbatim,
          never through t(), and escaped by ERB's default. %>
      <td data-label="<%= t("teams.show.note") %>"><%= row.note %></td>
      <td data-label="<%= t("teams.show.amount") %>"><%= row.amount %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
