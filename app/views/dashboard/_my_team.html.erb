<fieldset class="card">
  <legend>
    <%= t("dashboard.my_team.legend") %>
  </legend>

  <% unless @current_user.member_of_any_team? %>

    <p>
      <%= t("dashboard.my_team.no_team") %>
    </p>

    <p>
      <%= link_to t("dashboard.my_team.create_team"), new_team_path, class: "btn" %>
    </p>

    <% @invitations.each do |invitation| %>
      <p><%= t("dashboard.my_team.invited", team: invitation.to_team.name) %>
        <em><%= link_to t("dashboard.my_team.accept"), "/invitations/accept/#{invitation.id}", id: "accept-invitation-#{invitation.id}" %></em>
        <em><%= link_to t("dashboard.my_team.decline"), "/invitations/reject/#{invitation.id}", id: "reject-invitation-#{invitation.id}" %></em>
      </p>
    <% end %>

  <% else %>

    <p>
      <%= @current_user.captain? ? t("dashboard.my_team.captain_of") : t("dashboard.my_team.member_of") %> <strong><%= @current_user.team.name %></strong>
    </p>

    <p>
      <%= link_to t("dashboard.my_team.go_to_team_room"), team_room_path %>
    </p>

  <% end %>
</fieldset>
