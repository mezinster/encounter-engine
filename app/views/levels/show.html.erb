<h2>
  <%= t("levels.show.title") %> "<strong><%= @level.name %></strong>"
</h2>

<p>
  <em>(<%= t("levels.show.game_prefix") %> "<%= link_to @game.name, game_path(@game) %>")</em>
</p>

<div class="panel">
  <p>
    <em><%= t("levels.show.text_label") %></em>
  </p>

  <p>
    <%= with_newlines(@level.text) %>
  </p>

  <p>
    <%= link_to t("levels.show.edit_link"), edit_game_level_path(@game, @level), class: "btn" unless @level.game.started? %>
  </p>

  <% unless @level.multi_question? %>
    <p>
      <em><%= t("levels.show.code_label") %></em>
      <div id="question-<%= @level.questions.first.id %>">
        <%= @level.correct_answer %>
        <%= link_to t("shared.edit_short"), game_level_question_answers_path(@game, @level, @level.questions.first) %>
      </div>
    </p>
  <% else %>
    <p>
      <em><%= t("levels.show.codes_label", count: @level.questions.count) %></em>
    </p>
    <% @level.questions.each do |question| %>
      <div id="question-<%=  question.id %>">
        <p><%= question.correct_answer %></p>
        <%= link_to t("shared.edit_short"), game_level_question_answers_path(@game, @level, question) %>
        <%# Only once there is more than one code -- the last one cannot be
            deleted anyway (QuestionsController#delete refuses it), so offering
            the link on a single-code level would be a button that only ever
            produces an error. Hidden on a started game for the same reason the
            action refuses one: removing a code retroactively un-answers it for
            teams that already found it. %>
        <% unless @level.game.started? %>
          <%= button_to t("levels.show.delete_code"),
                      delete_game_level_question_path(@game, @level, question),
                      :method => :delete,
                      :class => "btn btn--danger",
                      :data => { :confirm => t("levels.show.delete_code_confirm", :code => question.correct_answer) } %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%# Stated for one-code levels too. Both rules behave identically there, and
      "Достаточно любого из кодов" stays true -- whereas showing the line only
      once a second code exists would mean it first appears after the author
      has already made the decision blind. That silence is the trap this
      closes. %>
  <p>
    <em><%= @level.any_code_passes? ? t("levels.codes_rule_any") : t("levels.codes_rule_all") %></em>
  </p>

  <p>
    <%= link_to t("levels.show.add_code"), new_game_level_question_path(@game, @level), class: "btn" %>
  </p>

  <%# Options turn a code question into a quiz question. ONE button per level,
      not one per code: a quiz level holds a single question by design ("each
      level is just a question"), and a row of identical buttons gave the
      author no way to tell which code each belonged to.

      Options hang off a Question, so this manages the FIRST code. On the rare
      multi-code level that choice is named in the link's suffix rather than
      left silent -- an author who genuinely wants options on a second code
      would otherwise have no way to see that this button does not reach it. %>
  <% first_question = @level.questions.first %>
  <% if first_question %>
    <p>
      <%= link_to t("levels.show.options_link"),
                  game_level_question_options_path(@game, @level, first_question), class: "btn" %>
      <% if @level.multi_question? %>
        <em><%= t("levels.show.options_for_code", :code => first_question.correct_answer) %></em>
      <% end %>
    </p>
  <% end %>
</div>

<fieldset class="card">
  <legend>
    <%= t("levels.show.hints_legend") %>
  </legend>

  <%= render "hints/list", hints: @level.hints %>

  <p>
    <%= link_to t("levels.show.add_hint"), new_game_level_hint_path(@game, @level), class: "btn" %>
  </p>
</fieldset>

<p class="danger-row">
  <%= button_to t("levels.show.delete_level"), delete_game_level_path(@game, @level), :method => :delete, :class => "btn btn--danger" %>
</p>

<p>
  <%= link_to t("levels.show.back_to_game", name: @level.game.name), game_path(@level.game) %>
</p>
