<h2>
  <%= t("levels.edit.title") %> "<strong><%= @level.name %></strong>"
</h2>

<p>
  <em>(<%= t("levels.edit.game_prefix") %> "<%= link_to @level.game.name, game_path(@level.game) %>")</em>
</p>

<br />

<%= error_messages_for @level, header: "<h2>#{t("shared.error_header")}</h2>" %>

<%= form_with model: [@level.game, @level], url: game_level_path(@level.game, @level) do |f| %>
  <p>
    <%= f.label :name, t("levels.form.name") %>
    <%= f.text_field :name %>
  </p>
  <p>
    <%= f.label :text, t("levels.form.text") %>
    <%= f.text_area :text %>
  </p>
  <%= f.submit t("levels.edit.submit") %>
  <em><%= link_to t("shared.cancel"), game_level_path(@level.game, @level) %></em>
<% end %>
