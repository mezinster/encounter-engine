<script language="javascript" src="/javascripts/jquery-1.3.2.min.js"></script>
<script language="javascript" src="/javascripts/level_hint_updater.js"></script>

<% content_locale = content_locale_for(@game_passing.game) %>

<h2>
  <%= t("game_passings.show_current_level.title_prefix") %> "<strong><%= @game.translated(:name, content_locale) %></strong>", <%= t("game_passings.show_current_level.level_label") %> #<%= @game_passing.current_level.position %>
</h2>

<%# Everything that may grow without bound -- task text, an accumulating pile
    of hints -- scrolls in here, so it can never push the two things below it
    off the screen. See .play-scroll in screens.css. %>
<div class="play-scroll">
<%= render "shared/content_language_switcher", :game => @game_passing.game %>

<fieldset class="card">
  <legend>
    <%= @game_passing.current_level.translated(:name, content_locale) %>
  </legend>

  <% if @game_passing.current_level.missing_translated_fields(Level::TRANSLATABLE_FIELDS, content_locale).any? %>
    <p class="notice"><%= t("game_passings.content_not_translated") %></p>
  <% end %>

  <%= @game_passing.current_level.translated(:text, content_locale) %>
</fieldset>

<div id="LevelHintsContainer">
  <% @game_passing.hints_to_show.each_with_index do |hint, index| %>
    <fieldset class="card">
      <legend>
        <%= t("game_passings.show_current_level.hint_label") %> #<%= index + 1 %>
      </legend>
      <%= hint.translated(:text, content_locale) %>
    </fieldset>
  <% end %>
</div>

<%# Counting toward a total is meaningless when any single code suffices --
    showing "0 из 3" to a team that needs only one is actively misleading. %>
<% if @game_passing.current_level.multi_question? && !@game_passing.current_level.any_code_passes? %>
  <div>
    <%= t("game_passings.show_current_level.multi_question_progress", answered: @game_passing.answered_questions.size, total: @game_passing.current_level.questions.count) %>
  </div>
<% end %>
</div>

<%# Outside the scrolling region on purpose: whether the last answer was
    refused, and the captain's way out of the game, are the two things that
    must be on screen no matter how long the task text runs or how many
    hints have landed. Both are short and fixed-height, so pinning them costs
    a bounded amount of room. %>
<div class="play-pinned">
  <% if answer_posted? %>
    <% if answer_was_correct? %>
      <div class="flash">
        <%= t("game_passings.show_current_level.answer_correct", answer: @answer) %>
      </div>
    <% else %>
      <p class="flash flash--alert">
        <%= t("game_passings.show_current_level.answer_incorrect", answer: @answer) %>
      </p>
    <% end %>
  <% elsif answer_rejected? %>
    <p class="flash flash--alert">
      <%= rejected_answer_message %>
    </p>
  <% end %>

  <% if current_user.captain? || @game.is_testing? %>
    <p>
      <% if current_user.captain? %>
        <%= button_to t("game_passings.show_current_level.exit_game"), exit_game_path(:game_id => @game_passing.game_id), :class => "btn" %>
      <% end %>
      <% if @game.is_testing? %>
        <%= button_to t("game_passings.show_current_level.finish_testing"), finish_test_game_path(@game), :class => "btn" %>
      <% end %>
    </p>
  <% end %>
</div>

<%# The pinned bar: the code field, the countdown to the next hint and the
    newest hint text, so the distance from "stuck" to "trying again" never
    grows as task text and hints accumulate above.

    Paused: no FORM at all, since codes are refused while paused
    (ensure_game_not_paused) and a field that still looked usable would be a
    lie. The countdown/script still render even while paused -- it seeds
    level_hint_updater.js off the game's frozen paused instant (see
    spec/requests/paused_hint_seeding_spec.rb), and the poll it drives
    already answers safely with no hint while paused
    (GamePassingsController#get_current_level_tip). %>
<div class="playbar">
  <% if @game.paused? %>
    <p class="playbar-paused"><%= t("game_passings.paused") %></p>
  <% end %>

  <%# Only once something has been charged. .countdown is the right class: a
      penalty is information, not an action, and that class is deliberately
      never filled or bordered so nothing that looks pressable appears here. %>
  <% if @game_passing.penalty_seconds.to_i > 0 %>
    <p class="playbar-penalty">
      <%= t("game_passings.show_current_level.penalty_label") %>
      <span class="countdown"><%= @game_passing.penalty_seconds / 60 %></span>
    </p>
  <% end %>

  <% newest = @game_passing.hints_to_show.last %>
  <%# Rendered even when empty: the poller needs an element to write into when
      the first hint fires, and a team that loaded the page before any hint
      would otherwise never get a pinned one. %>
  <div class="playbar-hint" id="PlaybarHint"<%= " hidden".html_safe if newest.nil? %>>
    <span class="playbar-hint-label"><%= t("game_passings.show_current_level.hint_label") %></span>
    <span class="playbar-hint-text" id="PlaybarHintText"><%= newest&.translated(:text, content_locale) %></span>
  </div>

  <% unless @game_passing.upcoming_hints.empty?  %>
    <div id="LevelHintCountdownContainer" class="countdown"><%= t("game_passings.show_current_level.until_next_hint") %> <span id="LevelHintCountdownTimerText"><%= t("game_passings.show_current_level.countdown_placeholder") %></span></div>
    <div id="LevelHintCountdownLoadIndicator" class="countdown" style="display: none;"><%= t("game_passings.show_current_level.loading") %></div>

    <script>
    LevelHintUpdater.setup({
      initialCountdownValue: <%= @game_passing.upcoming_hints.first.available_in(@game_passing.current_level_entered_at, @game_passing.effective_now) %>
      ,gameId: <%= @game_passing.game_id %>
    })
    </script>
  <% else %>
    <div class="countdown">
    <%= t("game_passings.show_current_level.no_more_hints") %>
    </div>
  <% end %>

  <% unless @game.paused? %>
    <% if @game_passing.current_level.quiz? %>
      <%= form_with url: post_answer_path(game_id: @game.id), method: :post, html: { class: "playbar-form playbar-form--quiz" } do %>
        <%# The ONLY scrolling part of the bar. Everything else in here -- the
            hint, the countdown, the code field on a mixed level, the submit
            button -- must stay put, and the task text, any flash and the
            captain's exit button must keep the top half of the screen. A
            quiz's option list is the one piece that can grow without bound,
            so it is the one piece that yields. See .playbar-questions in
            screens.css. %>
        <div class="playbar-questions">
        <%# unanswered_questions, not questions: an answered question that is
            still on the form can be submitted again, and a wrong pick charges
            the penalty a second time for a question the team already got
            right. %>
        <% @game_passing.unanswered_questions.select(&:quiz?).each do |quiz_question| %>
          <fieldset class="quiz-question">
            <legend><%= t("game_passings.show_current_level.choose") %></legend>
            <% quiz_question.ordered_options.each do |option| %>
              <label class="quiz-option">
                <%# Both controls use the [] name so the params shape is
                    identical either way: radios sharing a name submit only the
                    selected one, giving the same { question_id => [option_id] }
                    the controller expects. %>
                <% if quiz_question.single_choice? %>
                  <%= radio_button_tag "option_ids[#{quiz_question.id}][]", option.id, false, id: "option_#{option.id}" %>
                <% else %>
                  <%= check_box_tag "option_ids[#{quiz_question.id}][]", option.id, false, id: "option_#{option.id}" %>
                <% end %>
                <%# Author content -- rendered verbatim, never through t(). %>
                <%= option.translated(:text, content_locale) %>
              </label>
            <% end %>
          </fieldset>
        <% end %>
        </div>

        <%# A level may mix a quiz question with a code question. Without this
            the code field simply never renders on such a level and it becomes
            unwinnable -- see finding 1 of the whole-branch review. Same
            markup as the code branch below: same name, same attributes. %>
        <% if @game_passing.current_level.questions.any? { |q| !q.quiz? } %>
          <%= label_tag :answer, t("game_passings.show_current_level.answer_label") %>
          <%= text_field_tag :answer, nil, autocapitalize: "off", autocorrect: "off", spellcheck: "false" %>
        <% end %>

        <%= submit_tag t("game_passings.show_current_level.submit"), class: "btn btn--go" %>
      <% end %>
    <% else %>
      <%= form_with url: post_answer_path(game_id: @game.id), method: :post, html: { class: "playbar-form" } do %>
        <%= label_tag :answer, t("game_passings.show_current_level.answer_label") %>
        <%= text_field_tag :answer, nil, autocapitalize: "off", autocorrect: "off", spellcheck: "false" %>
        <%= submit_tag t("game_passings.show_current_level.submit"), class: "btn btn--go" %>
      <% end %>
    <% end %>
  <% end %>
</div>
