<% content_for :head do %>
  <script src="/javascripts/calendar.js"></script>
  <script src="/javascripts/calendar-setup.js"></script>
  <script src="/javascripts/calendar-ru-UTF.js"></script>
  <link rel="stylesheet" href="/stylesheets/calendar.css">
<% end %>

<%= error_messages_for @game, header: "<h2>#{t("shared.error_header")}</h2>" %>

<% active_locale = params[:tab].presence_in(@game.available_locale_list) || @game.primary_locale %>
<%= render "shared/language_tabs", :game => @game, :record => @game,
                                   :fields => Game::TRANSLATABLE_FIELDS,
                                   :active => active_locale %>

<%# Game#primary_locale_is_settled rejects changing primary_locale once the
    game has any content_translations, or once it's no longer a draft -- the
    form should not invite an edit the model will reject. %>
<% primary_locale_locked = @game.content_translations.any? || !@game.draft? %>

<%= form_with model: @game, url: game_path(@game) do |f| %>
  <div class="field">
    <%= f.label :name, t("games.form.name") %>
    <% if active_locale == @game.primary_locale %>
      <%= f.text_field :name %>
    <% else %>
      <%= text_field_tag "game[translations][#{active_locale}][name]",
                         @game.translation_draft(:name, active_locale) %>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :description, t("games.form.description") %>
    <% if active_locale == @game.primary_locale %>
      <%= f.text_area :description %>
    <% else %>
      <%= text_area_tag "game[translations][#{active_locale}][description]",
                        @game.translation_draft(:description, active_locale) %>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :primary_locale, t("games.primary_locale_label") %>
    <% if primary_locale_locked %>
      <%= t("locales.#{@game.primary_locale}") %>
    <% else %>
      <%= f.select :primary_locale, I18n.available_locales.map { |l| [t("locales.#{l}"), l] } %>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :available_locale_list, t("games.available_locales_label") %>
    <% I18n.available_locales.each do |locale| %>
      <% is_primary = locale.to_s == @game.primary_locale.to_s %>
      <label>
        <% if is_primary %>
          <%= check_box_tag "game[available_locale_list][]", locale, true, :disabled => true %>
          <%= hidden_field_tag "game[available_locale_list][]", locale %>
        <% else %>
          <%= check_box_tag "game[available_locale_list][]", locale,
                            @game.available_locale_list.include?(locale.to_s) %>
        <% end %>
        <%= t("locales.#{locale}") %>
      </label>
    <% end %>
  </div>
  <div class="field">
    <%= f.label :starts_at, t("games.form.starts_at") %>
    <%= f.text_field :starts_at %> <input id="calendar-switch" type="button" value="..." class="btn" />
  </div>
  <div class="field">
    <%= f.label :registration_deadline, t("games.form.registration_deadline") %>
    <%= f.text_field :registration_deadline %> <input id="calendar-switch2" type="button" value="..." class="btn" />
  </div>
  <div class="field">
    <%= f.label :max_team_number, t("games.form.max_team_number") %>
    <%= f.text_field :max_team_number %>
  </div>
  <div class="field">
    <%= f.label :visibility, t("games.form.is_draft") %>
    <%= f.check_box :visibility, {}, "draft", "listed" %>
  </div>
  <div class="field">
    <%= f.label :points_enabled, t("games.form.points_enabled") %>
    <%= f.check_box :points_enabled %>
  </div>
  <div class="field">
    <%= f.label :level_completion_points, t("games.form.level_completion_points") %>
    <%= f.number_field :level_completion_points, :min => 0 %>
  </div>
  <div class="field">
    <%= f.label :game_completion_points, t("games.form.game_completion_points") %>
    <%= f.number_field :game_completion_points, :min => 0 %>
  </div>
  <%# Same predicate and same single-field shape as games/new.html.erb -- see
      the comment there. %>
  <% if logged_in? && current_user.may_operate_commercial? %>
    <div class="field">
      <%= f.label :access_mode, t("games.form.access_mode") %>
      <%= f.select :access_mode, Game::ACCESS_MODES.map { |m| [t("games.form.access_mode_#{m}"), m] } %>
    </div>
  <% end %>
  <%= f.submit t("games.edit.submit"), class: "btn btn--go" %>
  <em><%= link_to t("shared.cancel"), game_path(@game) %></em>
<% end %>

<%# AI translation. Superadmin-only and hidden entirely without an API key, so
    an author never sees a control they cannot use. Outside the form above:
    button_to renders its own <form>, and forms do not nest. %>
<% if logged_in? && current_user.superadmin? && Translation::Client.configured? %>
  <div class="translate-panel">
    <h3><%= t("translations.edit.heading") %></h3>
    <ul class="translate-locales">
      <% (I18n.available_locales.map(&:to_s) - [ @game.primary_locale.to_s ]).each do |locale| %>
        <li>
          <%= t("locales.#{locale}") %>
          <%= button_to t("translations.edit.translate"),
                        game_translation_runs_path(@game),
                        :params => { :"locales[]" => locale },
                        :class => "btn" %>
        </li>
      <% end %>
    </ul>
    <%= link_to t("translations.edit.translate_multiple"), new_game_translation_run_path(@game) %>
  </div>
<% end %>

<script type="text/javascript">
  Calendar.setup(
    {
      inputField  : "game_starts_at",
      ifFormat    : "%Y-%m-%d %H:%M",
      button      : "calendar-switch",
      showsTime   : true
    }
  );
  Calendar.setup(
  {
    inputField  : "game_registration_deadline",
    ifFormat    : "%Y-%m-%d %H:%M",
    button      : "calendar-switch2",
    showsTime   : true
  }
);
</script>
