<% @my_games = Game.by(current_user) %>
<fieldset id="mygames">
  <legend>
    <%= t("dashboard.my_games.legend", count: @my_games.count) %>
  </legend>

  <p>
    <%= render "games/list", games: @my_games %>
  </p>

  <br />

  <hr class="short-line" />

  <p>
    <%= link_to t("dashboard.my_games.create"), new_game_path %>
  </p>
</fieldset>
